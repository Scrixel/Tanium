<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Upon creation of Training ISR from Training and PS record, if Tanium Training Type = Customer Paid then this flow will autofil Account, Opportunity and Product Version
Jira Ticket SS-1132 - Remove Active Modules Field
10/18/23: SS-5361 - Add Opportunity_Product__c where Product__c exists
SS-11151: Removed referenced to deprecated TAM fields.</description>
    <environments>Default</environments>
    <interviewLabel>Fill Product Version on {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fill Info on Customer Paid Training Request ISR</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>LookUp_Account</name>
        <label>LookUp Account</label>
        <locationX>558</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Lookup_Account_Owner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TrainingandPSRecord.Account_ID__c</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>Account</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>RVP__c</queriedFields>
        <queriedFields>Area_VP__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Lookup_Account_Owner</name>
        <label>Lookup Account Owner</label>
        <locationX>682</locationX>
        <locationY>49</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Training_Request_ISR</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Account.OwnerId</elementReference>
            </value>
        </filters>
        <object>User</object>
        <outputReference>AccountOwner</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>RVP__c</queriedFields>
        <queriedFields>Area_VP__c</queriedFields>
        <queriedFields>VP__c</queriedFields>
        <queriedFields>ManagerId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>LookUp_TrainingandPS</name>
        <label>LookUp TrainingandPS</label>
        <locationX>419</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LookUp_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TrainingandPSID</elementReference>
            </value>
        </filters>
        <object>Training_PS__c</object>
        <outputReference>TrainingandPSRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Account__c</queriedFields>
        <queriedFields>Opportunity__c</queriedFields>
        <queriedFields>Product__c</queriedFields>
        <queriedFields>Product_Description__c</queriedFields>
        <queriedFields>Account_ID__c</queriedFields>
        <queriedFields>Opportunity_ID__c</queriedFields>
        <queriedFields>Account_Owner_ID__c</queriedFields>
        <queriedFields>Opportunity_Product__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Training_Request_ISR</name>
        <label>Update Training Request ISR</label>
        <locationX>809</locationX>
        <locationY>49</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TrainingRequestISRID</elementReference>
            </value>
        </filters>
        <filters>
            <field>Tanium_Training_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Customer Paid</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>AVP__c</field>
            <value>
                <elementReference>AccountOwner.Area_VP__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Account_Owner__c</field>
            <value>
                <elementReference>TrainingandPSRecord.Account_Owner_ID__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>TrainingandPSRecord.Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity__c</field>
            <value>
                <elementReference>TrainingandPSRecord.Opportunity__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product_Name__c</field>
            <value>
                <elementReference>TrainingandPSRecord.Opportunity_Product__r.Product2Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RVP__c</field>
            <value>
                <elementReference>AccountOwner.ManagerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>VP__c</field>
            <value>
                <elementReference>AccountOwner.VP__c</elementReference>
            </value>
        </inputAssignments>
        <object>Account_Support_Request__c</object>
    </recordUpdates>
    <start>
        <locationX>39</locationX>
        <locationY>31</locationY>
        <connector>
            <targetReference>LookUp_TrainingandPS</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>Account</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>AccountOwner</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>
    <variables>
        <name>TrainingandPSID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>TrainingandPSRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Training_PS__c</objectType>
    </variables>
    <variables>
        <name>TrainingRequestISR</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account_Support_Request__c</objectType>
    </variables>
    <variables>
        <name>TrainingRequestISRID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
