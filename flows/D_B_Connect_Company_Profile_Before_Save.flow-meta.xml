<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Account</name>
        <label>Assign Account</label>
        <locationX>691</locationX>
        <locationY>611</locationY>
        <assignmentItems>
            <assignToReference>$Record.Tanium_Account_Record__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Matched_Account.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Sync_to_Account</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>If specific fields on the D&amp;B Company Profile records are updated, the Sync to Account field is updated.</description>
        <name>Sync_to_Account</name>
        <label>Sync to Account?</label>
        <locationX>544</locationX>
        <locationY>612</locationY>
        <assignmentItems>
            <assignToReference>$Record.Sync_to_Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formula_Sync_to_Account</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>formula_IsNew = False
AND Tanium Account Is Null
match only on UPDATE, real Id</description>
        <name>Account_Field_Populated</name>
        <label>Account Field Populated?</label>
        <locationX>534</locationX>
        <locationY>371</locationY>
        <defaultConnector>
            <targetReference>Sync_to_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>No_Account_Field_Not_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tanium_Account_Record__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Matched_Account</targetReference>
            </connector>
            <label>No Account Populated</label>
        </rules>
    </decisions>
    <decisions>
        <description>Was a Matched Account found? If so, make the update, if not, do nothing.</description>
        <name>Found_Account</name>
        <label>Found Account?</label>
        <locationX>782</locationX>
        <locationY>486</locationY>
        <defaultConnectorLabel>No Account Found</defaultConnectorLabel>
        <rules>
            <name>Yes_Account_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matched_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account</targetReference>
            </connector>
            <label>Yes - Account Found</label>
        </rules>
    </decisions>
    <description>7/30/26: SS-13689 First decision updated so that its not firing when ISNEW = TRUE
6/11/26: SS-13350 - When Enrich fields are changed on the D&amp;B Company Profile record, then the Sync to Account is set to true</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>formula_Sync_to_Account</name>
        <dataType>Boolean</dataType>
        <expression>IF(
  OR(
    ISCHANGED({!$Record.family_treeRole_GU_code__c}),
    ISCHANGED({!$Record.family_treeRole_DU_code__c}),
    ISCHANGED({!$Record.GU_primAddr_AddrLocal_name__c}),
    ISCHANGED({!$Record.DU_primAddr_AddrLocal_name__c}),
    ISCHANGED({!$Record.primAddr_AddrLocal_name__c}),
    ISCHANGED({!$Record.GU_primAddr_Region_abbrName__c}),
    ISCHANGED({!$Record.DU_primAddr_Region_abbrName__c}),
    ISCHANGED({!$Record.primAddr_Region_abbrName__c}),
    ISCHANGED({!$Record.GU_primAddr_Cntry_name__c}),
    ISCHANGED({!$Record.DU_primAddr_Cntry_name__c}),
    ISCHANGED({!$Record.primAddr_Cntry_name__c}),
    ISCHANGED({!$Record.GU_primAddr_Cntry_isoAlpha2__c}),
    ISCHANGED({!$Record.DU_primAddr_Cntry_isoAlpha2__c}),
    ISCHANGED({!$Record.DNBConnect__ISO_Alpha_2_Char_Country_Code__c}),
    ISCHANGED({!$Record.GU_primAddr_postalCode__c}),
    ISCHANGED({!$Record.DU_primAddr_postalCode__c}),
    ISCHANGED({!$Record.primAddr_postalCode__c}),
    ISCHANGED({!$Record.GU_Fins_yearlyRevenue_curr_1__c}),
    ISCHANGED({!$Record.GU_Fins_yearlyRevenue_value_1__c}),
    ISCHANGED({!$Record.GU_Fins_yearlyRevenue_curr_2__c}),
    ISCHANGED({!$Record.GU_Fins_yearlyRevenue_value_2__c}),
    ISCHANGED({!$Record.DU_Fins_yearlyRevenue_curr_1__c}),
    ISCHANGED({!$Record.DU_Fins_yearlyRevenue_value_1__c}),
    ISCHANGED({!$Record.DU_Fins_yearlyRevenue_curr_2__c}),
    ISCHANGED({!$Record.DU_Fins_yearlyRevenue_value_2__c}),
    ISCHANGED({!$Record.Fins_yearlyRevenue_curr_1__c}),
    ISCHANGED({!$Record.Fins_yearlyRevenue_value_1__c}),
    ISCHANGED({!$Record.Fins_yearlyRevenue_curr_2__c}),
    ISCHANGED({!$Record.Fins_yearlyRevenue_value_2__c}),
    ISCHANGED({!$Record.GU_numOfEmpl_value__c}),
    ISCHANGED({!$Record.DU_numOfEmpl_value__c}),
    ISCHANGED({!$Record.numberofemployees_val_Cons__c}),
    ISCHANGED({!$Record.organization_website_address_url__c}),
    ISCHANGED({!$Record.Sum_text__c}),
    ISCHANGED({!$Record.IndustCodes_NAICS_priority1__c}),
    ISCHANGED({!$Record.IndustCodes_NAICS_priority2__c}),
    ISCHANGED({!$Record.IndustCodes_Descr_NAICS_priority2__c}),
    ISCHANGED({!$Record.IndustCodes_NAICS_priority3__c}),
    ISCHANGED({!$Record.IndustCodes_Descr_NAICS_priority3__c}),
    ISCHANGED({!$Record.IndustCodes_NAICS_priority4__c}),
    ISCHANGED({!$Record.IndustCodes_Descr_NAICS_priority4__c}),
    ISCHANGED({!$Record.IndustCodes_NAICS_priority5__c}),
    ISCHANGED({!$Record.IndustCodes_Descr_NAICS_priority5__c}),
    ISCHANGED({!$Record.IndustCodes_NAICS_priority6__c}),
    ISCHANGED({!$Record.IndustCodes_Descr_NAICS_priority6__c})
  ),
  TRUE,
  {!$Record.Sync_to_Account__c}
)</expression>
    </formulas>
    <interviewLabel>D&amp;B Connect Company Profile - Before Save {!$Flow.CurrentDateTime}</interviewLabel>
