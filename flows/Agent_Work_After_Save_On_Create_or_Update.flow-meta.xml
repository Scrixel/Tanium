    <decisions>
        <description>Checks if the related Case is has high severity.</description>
        <name>High_severity_Case</name>
        <label>High-severity Case?</label>
        <locationX>911</locationX>
        <locationY>754</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_HighSeverity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Case.Severity_Community__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>3</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Prior_AgentWork</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>This checks if the  Get related Case is not Null. If yes, the flow proceeds to the Severity Check. If the record is null, the flow ends.</description>
        <name>Is_Case_found</name>
        <label>Is Case found?</label>
        <locationX>908</locationX>
        <locationY>613</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>High_severity_Case</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>If no prior closed AgentWork found, case is a fresh assignment. Otherwise, suppress notification.</description>
        <name>Is_Fresh_Assignment</name>
        <label>Is_Fresh_Assignment</label>
        <locationX>1172</locationX>
        <locationY>754</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_FreshAssignment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Prior_AgentWork.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.User.Id</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>005</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_AgentId</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks for the Work Item that has status changed to Open</description>
        <name>Is_Status_Open</name>
        <label>Is Status Open?</label>
        <locationX>900</locationX>
        <locationY>371</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opened</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Opened</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Related_Case</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>SS-13028 -  Send Custom Notification when Omni assigned high priority cases.</description>
    <environments>Default</environments>
    <interviewLabel>Agent Work - After Save - On Create or Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Agent Work - After Save - On Create or Update</label>
    <processMetadataValues>
