    <assignments>
        <description>Assign AgentId to var_AgentId</description>
        <name>Assign_AgentId</name>
        <label>Assign AgentId</label>
        <locationX>1329</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>var_AgentId</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.UserId</elementReference>
            </value>
        </assignmentItems>
