    <formulas>
        <name>formula_ConcatenatedSENextStep</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!formula_SENextStepforConcat}) + LEN({!Lookup_Opportunity.TAM_Next_Steps__c}) &lt; 32768, {!formula_SENextStepforConcat} &amp; BR() &amp; BR() &amp; {!Lookup_Opportunity.TAM_Next_Steps__c}, {!formula_SENextStepforConcat} &amp; BR() &amp; BR() &amp; LEFT({!Lookup_Opportunity.TAM_Next_Steps__c}, LEN({!Lookup_Opportunity.TAM_Next_Steps__c}) -  LEN({!formula_SENextStepforConcat})))</expression>
    </formulas>
    <formulas>
        <name>formula_FaultCustomMessage</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!$Flow.FaultMessage}, &quot;FIELD_CUSTOM_VALIDATION_EXCEPTION&quot;),
SUBSTITUTE({!$Flow.FaultMessage}, 
&quot;This error occurred when the flow tried to create records: FIELD_CUSTOM_VALIDATION_EXCEPTION&quot;, 
&quot;There is a validation rule on the opportunity preventing you from creating the next step&quot;) 
&amp; SUBSTITUTE({!$Label.LineBreak},&quot;-&quot;,&quot;&quot;) &amp;
SUBSTITUTE({!$Label.LineBreak},&quot;-&quot;,&quot;&quot;) &amp;
&quot;Please update the opportunity and then create the next step.&quot;, 

&quot;The error is: &quot;
&amp; SUBSTITUTE({!$Label.LineBreak},&quot;-&quot;,&quot;&quot;) &amp;
SUBSTITUTE({!$Label.LineBreak},&quot;-&quot;,&quot;&quot;) &amp;
{!$Flow.FaultMessage})</expression>
    </formulas>
    <formulas>
        <name>formula_SENextStepFlowTimeStamp</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Flow.CurrentDate}) &amp; &apos; - &apos; &amp; 
{!Lookup_Opportunity.TAM_Sales_SME_Owner__r.Name}
&amp; BR() &amp; 
{!formula_SENextStepText}
&amp; BR() &amp; &apos;_________________________________________&apos;</expression>
    </formulas>
    <formulas>
        <name>formula_SENextStepforConcat</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Flow.CurrentDate}) &amp; &apos; - &apos; &amp; {!Find_SE.Name} &amp; BR() &amp; {!formula_SENextStepText} &amp; BR() &amp; &apos;_________________________________________&apos;</expression>
    </formulas>
    <formulas>
        <name>formula_SENextStepOpportunityUpdate</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!formula_SENextStepFlowTimeStamp}) + LEN({!Lookup_Opportunity.TAM_Next_Steps__c}) &lt; 32768, {!formula_SENextStepFlowTimeStamp} &amp; BR() &amp; BR() &amp; {!Lookup_Opportunity.TAM_Next_Steps__c}, {!formula_SENextStepFlowTimeStamp} &amp; BR() &amp; BR() &amp; LEFT({!Lookup_Opportunity.TAM_Next_Steps__c}, LEN({!Lookup_Opportunity.TAM_Next_Steps__c}) -  LEN({!formula_SENextStepFlowTimeStamp})))</expression>
    </formulas>
    <formulas>
        <name>formula_SENextStepText</name>
        <dataType>String</dataType>
        <expression>&apos;Target Tech Win Date: &apos; &amp; TEXT({!SE_Next_Step_Target_Tech_Win_Date}) &amp; BR() &amp; BR() &amp; &apos;Next Step: &apos;  &amp; {!SE_Next_Step_Next_Step} &amp; BR()  &amp; BR() &amp;  &apos;Risk: &apos; &amp; {!Risk_LongText} &amp; BR() &amp; BR() &amp; &apos;Description: &apos; &amp; {!Description_LongText}</expression>
    </formulas>
