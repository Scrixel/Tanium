    <recordLookups>
        <description>Get Campaign Member records from Primary Opportunity Contact Id where Campaign Member Responded Date is &lt; Opportunity Created Date AND Responded Date is &gt; Opportunity Created Date - 365 days.</description>
        <name>Get_Primary_Contact_Campaign_Member_Records</name>
        <label>Get Primary Contact Campaign Member Records</label>
        <locationX>762</locationX>
        <locationY>230</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Campaign_Member_Records_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>record_Opportunity.Primary_Opportunity_Contact__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Responded_Date__c</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>OppCreatedDateMinus365Formula</elementReference>
            </value>
        </filters>
        <filters>
            <field>Responded_Date__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>record_Opportunity.CreatedDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CampaignMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
