    <decisions>
        <name>Partner_Discount_Mismatch</name>
        <label>Partner Discount Mismatch?</label>
        <locationX>972</locationX>
        <locationY>1048</locationY>
        <defaultConnector>
            <targetReference>Total_Discount_Partner_Discount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Partner_Discount_Mismatch</name>
            <conditionLogic>(1 AND 2) OR (1 AND 3 AND (4 OR 5)) OR (6 AND 7)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Tanium_Partner_Discount__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tanium_Partner_Discount__r.Total_Discount__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SBQQ__PartnerDiscount__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tanium_Partner_Discount__r.Total_Discount__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SBQQ__PartnerDiscount__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Partner_Discount_Overridden__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Increased</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Partner_Discount_Overridden__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Decreased</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tanium_Partner_Discount__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tanium_Partner_Discount__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Partner_Discount</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
