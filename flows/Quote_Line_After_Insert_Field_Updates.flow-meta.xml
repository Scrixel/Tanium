    <description>02/06/2025 - SS-9445: Set Quota Retirement ARR (EDW) equal to Quota Retirement ARR if there&apos;s a mismatch 
01/16/2025 - SS-9992: Set End Date Comp (EDW) equal to End Date Comp if there&apos;s a mismatch
Add validation if update is needed
Will perform actions on a Quote Line record after it&apos;s been inserted/saved
6/20/24: SS-8250: Adding decision and assignment for Change from Programmatic Discount</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_ChangeProgrammaticDiscount</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Discount_Percent_Display__c} - {!$Record.Tanium_Partner_Discount__r.Total_Discount__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_PartnerDiscountDifference</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.Tanium_Partner_Discount__c}), 0, {!$Record.SBQQ__PartnerDiscount__c}- {!$Record.Tanium_Partner_Discount__r.Total_Discount__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_PartnerDiscountOverridden</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Tanium_Partner_Discount__r.Total_Discount__c} &gt; {!$Record.SBQQ__PartnerDiscount__c}, &apos;Decreased&apos;, IF({!$Record.Tanium_Partner_Discount__r.Total_Discount__c} &lt; {!$Record.SBQQ__PartnerDiscount__c}, &apos;Increased&apos;, IF({!$Record.Tanium_Partner_Discount__r.Total_Discount__c} = {!$Record.SBQQ__PartnerDiscount__c}, &apos;Same&apos;, NULL)))</expression>
    </formulas>
