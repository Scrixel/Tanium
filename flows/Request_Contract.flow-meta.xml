    <environments>Default</environments>
    <formulas>
        <name>formula_ChatterPostMessage</name>
        <dataType>String</dataType>
        <expression>{!$User.Full_Name__c} &amp; &quot; has requested that a &quot; &amp; {!Agreement_Type_Selection} &amp; &quot; be created for this opportunity.&quot;</expression>
    </formulas>
    <formulas>
        <name>formula_CustomNotificationRecipients</name>
        <dataType>String</dataType>
        <expression>IF({!Agreement_Type_Selection} = &quot;NDA&quot;,{!constant_NDAContractOwner_Id},
IF(AND({!Agreement_Type_Selection}= &quot;License Schedule&quot;, TEXT({!Get_Opportunity.Transaction_Type__c}) = &quot;Direct&quot;),{!Get_Opportunity.Contract_Owner__c},
IF(AND({!Agreement_Type_Selection}= &quot;License Schedule&quot;, TEXT({!Get_Opportunity.Transaction_Type__c}) = &quot;Indirect&quot;),{!Get_Opportunity.Contract_Owner__c} &amp; &quot;,&quot; &amp; {!Get_Opportunity.Contract_Partner_Owner__c},
{!Get_Opportunity.Contract_Owner__c})))</expression>
    </formulas>
    <formulas>
        <name>formula_EmailRecipients</name>
        <dataType>String</dataType>
        <expression>IF({!Agreement_Type_Selection} = &quot;NDA&quot;,{!constant_NDAContractOwner},
IF(AND({!Agreement_Type_Selection}= &quot;License Schedule&quot;, TEXT({!Get_Opportunity.Transaction_Type__c}) = &quot;Direct&quot;),{!Get_Opportunity.Contract_Owner__r.Email},
IF(AND({!Agreement_Type_Selection}= &quot;License Schedule&quot;, TEXT({!Get_Opportunity.Transaction_Type__c}) = &quot;Indirect&quot;),{!Get_Opportunity.Contract_Owner__r.Email} &amp; &quot;,&quot; &amp; {!Get_Opportunity.Contract_Partner_Owner__r.Email},
{!Get_Opportunity.Contract_Owner__r.Email})))</expression>
    </formulas>
    <formulas>
        <name>formula_EmailSubject</name>
        <dataType>String</dataType>
        <expression>&quot;A new &quot; &amp; {!Agreement_Type_Selection} &amp; &quot; has been requested on opportunity &quot; &amp; {!Get_Opportunity.Name}</expression>
    </formulas>
