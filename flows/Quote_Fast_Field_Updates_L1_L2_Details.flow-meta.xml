    <formulas>
        <name>NoAccreditation</name>
        <dataType>Boolean</dataType>
        <expression>IF( INCLUDES(  {!$Record.L1_L2_Support_Partner__r.Business_Motion__c} , &quot;End User Support&quot;), True, False)</expression>
