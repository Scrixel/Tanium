    <decisions>
        <name>Is_Quote_New</name>
        <label>Is Quote New</label>
        <locationX>333</locationX>
        <locationY>404</locationY>
        <defaultConnector>
            <targetReference>L1_L2_Fields_is_changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>f_NewQuote</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>L1_L2_Provider_Account</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>L1_L2_Fields_is_changed</name>
        <label>L1/L2 Fields is changed</label>
        <locationX>152</locationX>
        <locationY>478</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes2</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Partner__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Exception_Granted__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>L1_L2_Provider_Account</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>L1/L2 Provoder Account Has Business Motion that contains &quot;Support&quot;</description>
        <name>L1_L2_Provider_Account</name>
        <label>L1/L2 Provider Account</label>
        <locationX>325</locationX>
        <locationY>579</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Partner__r.Business_Motion__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Support</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Partner__r.Partner_Accreditations__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Exception Approved - Support L1/L2</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Exception_Granted__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Partner__r.Partner_Accreditations__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Fully Accredited - Support L1/L2</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_L1_L2_Discount_Eligibility</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
        <rules>
            <name>Uncheck</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Partner__r.Id</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Exception_Granted__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Exception_Granted__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Uncheck1</targetReference>
            </connector>
            <label>Uncheck</label>
        </rules>
    </decisions>
    <decisions>
        <name>Uncheck1</name>
        <label>Uncheck</label>
        <locationX>321</locationX>
        <locationY>754</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes1</name>
            <conditionLogic>( 1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Exception_Granted__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.L1_L2_Support_Partner__r.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NoAccreditation</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Uncheck_L1_L2_Discount_Eligibility</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Quote Fast Field Updates on Create or Edit for L1 and L2 Fields</description>
