    <description>8.20.26 - SS-13266 - Notify Primary PFS Territory Owner on Deal Registration Status Changes. 
8.12.26 - SS-13819 - Updated formula_EmailRecipients to resolve deprecated Kondo field references. 
10.16.25 - SS-11920 - Add update Opp element to Map Deal Reg ID to Opp when Approved. 
9.16.25 - SS-11660 - Automatically  Submit Deal Reg for Approval when it hasn&apos;t been submitted before. 
05.02.25 - SS-10774 - Fix to ensure that quotes are updated when Deal expires</description>
    <environments>Default</environments>
    <formulas>
        <name>Formula_ApprovalEntryCriteria</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISBLANK($Record.Opp_Reg_Conversion_Inconsistencies__c),
 {!$Record.Opp_Reg_Extension_Count__c} = 0,
  {!$Record.or_New_Opp_Reg__c},
  TEXT({!$Record.or_Opp_Reg_Approval_Flow_Status__c}) = &apos;Approvals not started&apos;,
  NOT(ISBLANK({!$Record.Mapped_Opportunity__c})), 
  NOT(ISBLANK({!$Record.Account__c}))
)</expression>
    </formulas>
    <formulas>
        <description>Updated via SS-13819. The formula previously referenced &apos;Level&apos; fields on the User object that were deprecated as a part of Project Kondo.</description>
        <name>formula_EmailRecipients</name>
        <dataType>String</dataType>
        <expression>&quot;ChannelOps@tanium.com&quot; &amp;
IF(
    NOT(ISBLANK({!$Record.or_Tanium_Contact_Email__c})),
    &quot;,&quot; &amp; {!$Record.or_Tanium_Contact_Email__c},
    &quot;&quot;
) &amp;
IF(
    NOT(ISBLANK({!$Record.Owner:User.Email})),
    &quot;,&quot; &amp; {!$Record.Owner:User.Email},
    &quot;&quot;
) &amp;
IF(
    NOT(ISBLANK({!$Record.Primary_PFS_Territory_Owner__r.Email})),
    &quot;,&quot; &amp; {!$Record.Primary_PFS_Territory_Owner__r.Email},
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formula_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>Sets the Partner Program Bucket field on unapproved quotes</description>
        <name>formula_PartnerProgramBucket</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.or_Opp_Reg_Status__c}) = &apos;Approved&apos;, TEXT({!$Record.or_Opportunity_Registration__c}), 
IF(TEXT({!Quote_Records.SBQQ__Type__c}) = &apos;Renewal&apos;, &apos;Renewal&apos;, &apos;Fulfill&apos;))</expression>
    </formulas>
    <formulas>
        <name>formula_RecordLink</name>
        <dataType>String</dataType>
        <expression>{!$Label.SalesforceURL}&amp;&quot;/&quot;&amp;{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>formula_TODAY</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
