    <assignments>
        <description>Get the Id of the record selected from the table of draft hardware requests</description>
        <name>Assign_Draft_Request_Id</name>
        <label>Assign Draft Request Id</label>
        <locationX>1208</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>var_SelectedDraftRequestId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_over_selected_draft_requests.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_over_selected_draft_requests</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign the total number of selected records</description>
        <name>Assign_Selected_Record_Total</name>
        <label>Assign Selected Record Total</label>
        <locationX>804</locationX>
        <locationY>362</locationY>
