            </value>
        </assignmentItems>
        <connector>
            <targetReference>Record_Selected_Check</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Increase the validation counter by 1 for each validation iteration. Controls visibility of the error alert banner.</description>
        <name>Increase_validation_counter</name>
        <label>Increase validation counter</label>
        <locationX>860</locationX>
        <locationY>43</locationY>
        <assignmentItems>
            <assignToReference>var_ValidationCounter</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>scn_ShowDraftRecords</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Reset the validation counter to zero (0) after validation is no longer required. Controls visibility of the error alert banner.</description>
        <name>Reset_validation_counter</name>
        <label>Reset validation counter</label>
        <locationX>1166</locationX>
        <locationY>33</locationY>
        <assignmentItems>
            <assignToReference>var_ValidationCounter</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Run_Configure_Hardware_Request_Flow</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Set the total number of requests found</description>
        <name>Set_Request_Found_Total</name>
        <label>Set Request Found Total</label>
        <locationX>551</locationX>
        <locationY>419</locationY>
        <assignmentItems>
            <assignToReference>var_TotalDraftRequests</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Hardware_Requests</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>scn_ShowDraftRecords</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check if draft requests were found for the running user</description>
        <name>Draft_Requests_Check</name>
        <label>Draft Requests Check</label>
        <locationX>392</locationX>
        <locationY>234</locationY>
        <defaultConnector>
            <targetReference>scn_No_Draft_Requests</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Draft Requests</defaultConnectorLabel>
        <rules>
            <name>Draft_Requests_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Hardware_Requests</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Request_Found_Total</targetReference>
            </connector>
            <label>Draft Requests Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check that a record was selected from the list</description>
        <name>Record_Selected_Check</name>
        <label>Record Selected Check</label>
        <locationX>853</locationX>
        <locationY>230</locationY>
        <defaultConnector>
            <targetReference>Increase_validation_counter</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No record selected</defaultConnectorLabel>
        <rules>
            <name>Record_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_TotalSelectedRecords</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_over_selected_draft_requests</targetReference>
            </connector>
            <label>Record Selected</label>
        </rules>
    </decisions>
    <description>TAN-936: Enables community users to reviewed draft requests to enable them to be submitted for approval. Updated record list icon. 
TAN-953: Added sort ascending by created date to draft requests, Removed footer for No draft requests screen.</description>
    <dynamicChoiceSets>
        <description>List of draft hardware requests</description>
        <name>rcs_DraftHardwareRequests</name>
        <dataType>String</dataType>
        <displayField>Request_Lookup__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CreatedById</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frm_RunningUserId</elementReference>
            </value>
        </filters>
        <object>Hardware_Form__c</object>
        <outputAssignments>
            <assignToReference>recordId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <formulas>
        <description>Get the id of the running user</description>
        <name>frm_RunningUserId</name>
        <dataType>String</dataType>
        <expression>{!$User.Id}</expression>
    </formulas>
    <interviewLabel>Hardware Review Draft Requests Screen Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Hardware Review Draft Requests Screen Flow</label>
    <loops>
        <description>Loop over selected draft requests to get the Id and assign it to recordId</description>
        <name>Loop_over_selected_draft_requests</name>
        <label>Loop over selected draft requests</label>
        <locationX>980</locationX>
        <locationY>395</locationY>
        <collectionReference>col_DraftHardwareRequestSelected</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Draft_Request_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Reset_validation_counter</targetReference>
        </noMoreValuesConnector>
    </loops>
