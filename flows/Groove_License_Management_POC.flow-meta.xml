    <formulas>
        <name>formula_AssignGrooveLicense</name>
        <dataType>String</dataType>
        <expression>IF(AND(ISCHANGED({!$Record.Groove_Core_License_Assigned__c}), {!$Record.Groove_Core_License_Assigned__c}), &apos;Core&apos;,
IF(AND(ISCHANGED({!$Record.Groove_Dialer_License_Assigned__c}), {!$Record.Groove_Dialer_License_Assigned__c}), &apos;Dialer&apos;,
IF(AND(ISCHANGED({!$Record.Groove_Flow_License_Assigned__c}), {!$Record.Groove_Flow_License_Assigned__c}), &apos;Flow&apos;,
NULL)))</expression>
    </formulas>
    <formulas>
        <name>formula_AuditTrailText</name>
        <dataType>String</dataType>
        <expression>{!$Record.User_Audit_Trail__c} + BR() + TEXT({!$Flow.CurrentDateTime}) + &quot; - &quot; + {!$User.Full_Name__c} + &quot; attempted to &quot; + IF(NOT(ISBLANK({!formula_AssignGrooveLicense})), &apos;assign&apos;, &apos;remove&apos;) + &quot; a Groove &quot; + IF(NOT(ISBLANK({!formula_AssignGrooveLicense})), {!formula_AssignGrooveLicense}, {!formula_RemoveGrooveLicense}) + &quot; license&quot;</expression>
    </formulas>
    <formulas>
        <name>formula_RemoveGrooveLicense</name>
        <dataType>String</dataType>
        <expression>IF(AND(ISCHANGED({!$Record.Groove_Core_License_Assigned__c}), NOT({!$Record.Groove_Core_License_Assigned__c})), &apos;Core&apos;,
IF(AND(ISCHANGED({!$Record.Groove_Dialer_License_Assigned__c}), NOT({!$Record.Groove_Dialer_License_Assigned__c})), &apos;Dialer&apos;,
IF(AND(ISCHANGED({!$Record.Groove_Flow_License_Assigned__c}), NOT({!$Record.Groove_Flow_License_Assigned__c})), &apos;Flow&apos;,
NULL)))</expression>
    </formulas>
