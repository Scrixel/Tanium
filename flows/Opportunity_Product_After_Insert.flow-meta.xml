<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checks if Opportunity Product includes &quot;Remote Screen Share - MSP&quot; SKU in it.</description>
        <name>Includes_Screen_Share_MSP_SKU</name>
        <label>Includes Screen Share MSP SKU?</label>
        <locationX>818</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>Update_Has_Remote_Screen_Share_MSP_in_Opp_to_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Remote Screen Share - MSP</defaultConnectorLabel>
        <rules>
            <name>Remote_Screen_Share_MSP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ProductCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SS-RMT-MSP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Has_Remote_Screen_Share_MSP_in_Opp_to_True</targetReference>
            </connector>
            <label>Remote Screen Share - MSP</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsTaniumInfrastructureFormSku</name>
        <label>Is Tanium Infrastructure Form Sku</label>
        <locationX>608</locationX>
        <locationY>385</locationY>
        <defaultConnector>
            <targetReference>Includes_Screen_Share_MSP_SKU</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesIsTaniumInfrastructureFormSku</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>TaniumInfrastructureFormFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Will update Opportunity Products and Related Records</description>
    <environments>Default</environments>
    <formulas>
        <description>Tanium Infrastructure Form Formula</description>
        <name>TaniumInfrastructureFormFormula</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Product2.Tanium_Infrastructure_Form_Needed__c}</expression>
    </formulas>
    <interviewLabel>Opportunity Product - After Insert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Product - After Insert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Has_Remote_Screen_Share_MSP_in_Opp_to_False</name>
        <label>Update &quot;Has Remote Screen Share - MSP&quot; in Opp to False</label>
        <locationX>1136</locationX>
        <locationY>383</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OpportunityId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Has_Remote_Screen_Share_MSP__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Has_Remote_Screen_Share_MSP_in_Opp_to_True</name>
        <label>Update &quot;Has Remote Screen Share MSP&quot; in Opp to True</label>
        <locationX>823</locationX>
        <locationY>613</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OpportunityId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Has_Remote_Screen_Share_MSP__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opportunity</name>
        <label>Update Opportunity</label>
        <locationX>616</locationX>
        <locationY>606</locationY>
        <inputAssignments>
            <field>New_Tanium_Physical_Appliance_Required__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Opportunity</inputReference>
    </recordUpdates>
    <start>
        <locationX>489</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>IsTaniumInfrastructureFormSku</targetReference>
        </connector>
        <object>OpportunityLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
