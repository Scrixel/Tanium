    <formulas>
        <name>Formula_FlowDate_TodayGMT</name>
        <dataType>DateTime</dataType>
        <expression>/*datetimevalue function - GMT timezone (7am GMT = 12am Pacific)*/
DATETIMEVALUE(
TEXT(YEAR({!$Flow.CurrentDate}))+&quot;-&quot; +
TEXT(MONTH({!$Flow.CurrentDate}))+&quot;-&quot; +
TEXT(DAY({!$Flow.CurrentDate})) +&quot; &quot; +
&quot;07:00:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Formula_FlowDate_YesterdayGMT</name>
        <dataType>DateTime</dataType>
        <expression>/*datetimevalue function - GMT timezone (7am GMT = 12am Pacific)*/
DATETIMEVALUE(
TEXT(YEAR({!$Flow.CurrentDate}))+&quot;-&quot; +
TEXT(MONTH({!$Flow.CurrentDate}))+&quot;-&quot; +
TEXT(DAY({!$Flow.CurrentDate})) +&quot; &quot; +
&quot;07:00:00&quot;
) + (-1)</expression>
