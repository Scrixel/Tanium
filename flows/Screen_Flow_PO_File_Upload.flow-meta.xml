    <decisions>
        <name>Have_Upload</name>
        <label>Have Upload?</label>
        <locationX>834</locationX>
        <locationY>221</locationY>
        <defaultConnector>
            <targetReference>Fault_Screen_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Have_Upload</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_CollectionLength</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Thru_ContentDocIDs</targetReference>
            </connector>
