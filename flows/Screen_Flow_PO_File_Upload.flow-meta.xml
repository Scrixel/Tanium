        <fields>
            <name>displayText_Signed_Purchase_Order_PDF</name>
            <fieldText>&lt;p&gt;&lt;img src=&quot;https://tanium--c.vf.force.com/resource/1718198757000/Alert_Icon_40x32?&quot;&gt;&lt;strong&gt;In order for an opportunity to be moved to Signed - Paperwork received, a final purchase order (PO) in PDF format must be attached. Before attaching your PO, please ensure it has the following information:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Tanium quote number referenced&lt;/li&gt;&lt;li&gt;A PO total that matches--or is greater than--the primary quote total&lt;/li&gt;&lt;li&gt;Meets all requirements on the &lt;a href=&quot;https://tanium.sharepoint.com/sites/IntranetHub-Order%20Operations/SitePages/Order-Requirements-Checklist.aspx&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Opportunity and Order Checklist&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); background-color: rgb(255, 255, 255);&quot;&gt;You can upload your Purchase Order file (in PDF format) by clicking the Upload Files button below. &lt;/span&gt;&lt;strong style=&quot;color: rgb(237, 3, 3); background-color: rgb(255, 255, 255); font-size: 14px;&quot;&gt;&lt;u&gt;When the upload finishes, click the Done button followed by the Finish Upload Process button to ensure the process completes and to avoid errors!&lt;/u&gt;&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
