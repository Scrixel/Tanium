<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checks if the record IsNew</description>
        <name>IsNew</name>
        <label>IsNew</label>
        <locationX>424</locationX>
        <locationY>383</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_IsNew</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>form_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.tackleio__OpportunityCrmId__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>SS-12229 - 3/19/26 - When a co-sell submission is sent to AWS through Tackle, the Salesforce Opportunity field AWS Registration Status is automatically updated to “Accepted by Partner”.</description>
    <environments>Default</environments>
    <formulas>
        <description>Check if record is New</description>
        <name>form_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Tackle AWS Co-sell Opportunity - After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Tackle AWS Co-sell Opportunity - After Save - On Create or Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Updated related Opportunity AWS Registration Status to “Accepted by Partner”</description>
        <name>Update_Opportunity</name>
        <label>Update Opportunity</label>
        <locationX>556</locationX>
        <locationY>379</locationY>
        <inputAssignments>
            <field>Co_sell_Status_AWS__c</field>
            <value>
                <stringValue>Accepted by Partner</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.tackleio__OpportunityCrmId__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>302</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>IsNew</targetReference>
        </connector>
        <filterFormula>NOT({!$Permission.DisableFlows})</filterFormula>
        <object>tackleio__TackleAwsCosellOpportunity__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
