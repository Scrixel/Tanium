        <locationX>1098</locationX>
        <locationY>385</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_CountryHasRestrictions</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Country_for_Export_Records.Country_Restrictions__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Direct Sales Permitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Country_for_Export_Records.Country_Restrictions__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Partner Permitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Auto_Reject_Values</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
