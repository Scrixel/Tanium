    <formulas>
        <description>Set the expiration date on the quote for 30 days out from today.</description>
        <name>formula_ExpirationDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()+30</expression>
    </formulas>
    <formulas>
        <description>This formula calculates if number of Seats on Account Related to Opportunity is between 0 and 10,000 which puts it into Mid-Market category</description>
        <name>formula_IsMidMarket</name>
        <dataType>Boolean</dataType>
        <expression>{!Get_Opportunity_Details.Account.Sales_Ops_Derived_EP__c} &gt;0 &amp;&amp;{!Get_Opportunity_Details.Account.Sales_Ops_Derived_EP__c} &lt; 10000 &amp;&amp; {!Get_Opportunity_Details.Pricebook2.Name} = &quot;Global Pricebook&quot;</expression>
    </formulas>
    <formulas>
        <name>formula_PartnerRequired</name>
        <dataType>Boolean</dataType>
        <expression>IF(OR(TEXT({!Get_Opportunity_Details.Business_Motion__c}) = &apos;MSP&apos;, {!formula_IsMidMarket}), TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>formula_ProfileName</name>
        <dataType>String</dataType>
        <expression>{!$Profile.Name}</expression>
    </formulas>
    <formulas>
        <name>formula_RenewalOrExpansionOrRestrictedCountry</name>
        <dataType>Boolean</dataType>
        <expression>IF(
  OR(
    AND(
      TEXT({!Get_Opportunity_Details.Type}) = &apos;Expansion&apos;, 
      TEXT({!Get_Opportunity_Details.Business_Motion__c}) != &apos;MSP&apos;,
      {!formula_ProfileName} != &apos;Tanium Deals Desk&apos;
    ),
    AND(
      TEXT({!Get_Opportunity_Details.Type}) = &apos;Renewal&apos;,
      {!formula_ProfileName} != &apos;Tanium Deals Desk&apos;
    ),
    AND(
      ISPICKVAL({!Get_Opportunity_Details.Account.Country_Restrictions__c}, &apos;Restricted&apos;),
      ISBLANK({!RestrictedCountryISR.Id})
    )
  ),
  TRUE,
  FALSE
)</expression>
    </formulas>
    <formulas>
        <name>formula_SupportProviderRequired</name>
        <dataType>Boolean</dataType>
        <expression>IF(AND({!formula_IsMidMarket}, TEXT({!Get_Opportunity_Details.Type}) != &apos;Expansion&apos;, TEXT({!Get_Opportunity_Details.Type}) != &apos;Training &amp; Tanium Services&apos;), TRUE, FALSE)</expression>
    </formulas>
