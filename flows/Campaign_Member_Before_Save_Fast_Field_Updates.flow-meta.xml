    <decisions>
        <description>Let&apos;s check to see if this is a new CampaignMember and if the UTM values need to be updated</description>
        <name>UTM_Values_need_to_be_updated</name>
        <label>UTM Values need to be updated?</label>
        <locationX>282</locationX>
        <locationY>597</locationY>
        <defaultConnector>
            <targetReference>Is_MQL_Tier_Blank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_UTMNeedsUpdates</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_UTMValueCheck</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_CampaignMember_a_Contact</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>SS-13210: Remove dependencies for uninstalled managed package; Populate UTM Fields from Lead or Contact if values don&apos;t match
Migrated from Campaign Member - Before Insert - Fast Field Updates flow
Flow updates Campaign&apos;s  UTM field values values from Lead and Contacts when campaign members are added.
5/16/2024; ITSC 00306127: Barbara requested the change of field mapping on the campaign member UTM Fields
SS-1041: Added UTM Asset fields
SS-1418: Added MQL Tier Auto-Assignment
SS-7493: Added field mapping for utm_id, utm_source_platform, utm_creative_format and utm_marketing_tactic</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>formula_UTMValueCheck</name>
        <dataType>Boolean</dataType>
        <expression>IF(
AND(IsNew(),
OR(
AND(
NOT(ISBLANK({!$Record.LeadId})), 
OR(
IF(ISBLANK({!$Record.UTM_Id__c}),&quot;&quot;,{!$Record.UTM_Id__c}) &lt;&gt; IF(ISBLANK({!$Record.Lead.UTM_Id__c}),&quot;&quot;,{!$Record.Lead.UTM_Id__c}),
IF(ISBLANK({!$Record.UTM_Asset__c}),&quot;&quot;,{!$Record.UTM_Asset__c}) &lt;&gt; IF(ISBLANK({!$Record.Lead.UTM_Asset__c}),&quot;&quot;,{!$Record.Lead.UTM_Asset__c}),
IF(ISBLANK({!$Record.UTM_Campaign__c}),&quot;&quot;,{!$Record.UTM_Campaign__c}) &lt;&gt; IF(ISBLANK({!$Record.Lead.UTM_Campaign__c}),&quot;&quot;,{!$Record.Lead.UTM_Campaign__c}),
IF(ISBLANK({!$Record.UTM_Content__c}),&quot;&quot;,{!$Record.UTM_Content__c}) &lt;&gt; IF(ISBLANK({!$Record.Lead.UTM_Content__c}),&quot;&quot;,{!$Record.Lead.UTM_Content__c}),
IF(ISBLANK({!$Record.UTM_Creative_Format__c}),&quot;&quot;,{!$Record.UTM_Creative_Format__c}) &lt;&gt; IF(ISBLANK({!$Record.Lead.UTM_Creative_Format__c}),&quot;&quot;,{!$Record.Lead.UTM_Creative_Format__c}),
IF(ISBLANK({!$Record.UTM_Marketing_Tactic__c}),&quot;&quot;,{!$Record.UTM_Marketing_Tactic__c}) &lt;&gt; IF(ISBLANK({!$Record.Lead.UTM_Marketing_Tactic__c}),&quot;&quot;,{!$Record.Lead.UTM_Marketing_Tactic__c}),
IF(ISBLANK({!$Record.UTM_Medium__c}),&quot;&quot;,{!$Record.UTM_Medium__c}) &lt;&gt; IF(ISBLANK({!$Record.Lead.UTM_Medium__c}),&quot;&quot;,{!$Record.Lead.UTM_Medium__c}),
IF(ISBLANK({!$Record.UTM_Source__c}),&quot;&quot;,{!$Record.UTM_Source__c}) &lt;&gt; IF(ISBLANK({!$Record.Lead.UTM_Source__c}),&quot;&quot;,{!$Record.Lead.UTM_Source__c}),
IF(ISBLANK({!$Record.UTM_Source_Platform__c}),&quot;&quot;,{!$Record.UTM_Source_Platform__c}) &lt;&gt; IF(ISBLANK({!$Record.Lead.UTM_Source_Platform__c}),&quot;&quot;,{!$Record.Lead.UTM_Source_Platform__c}),
IF(ISBLANK({!$Record.UTM_Term__c}),&quot;&quot;,{!$Record.UTM_Term__c}) &lt;&gt; IF(ISBLANK({!$Record.Lead.UTM_Term__c}),&quot;&quot;,{!$Record.Lead.UTM_Term__c})
   )
),
AND(
NOT(ISBLANK({!$Record.ContactId})), 
OR(
IF(ISBLANK({!$Record.UTM_Id__c}),&quot;&quot;,{!$Record.UTM_Id__c}) &lt;&gt; IF(ISBLANK({!$Record.Contact.UTM_Id__c}),&quot;&quot;,{!$Record.Contact.UTM_Id__c}),
IF(ISBLANK({!$Record.UTM_Asset__c}),&quot;&quot;,{!$Record.UTM_Asset__c}) &lt;&gt; IF(ISBLANK({!$Record.Contact.UTM_Asset__c}),&quot;&quot;,{!$Record.Contact.UTM_Asset__c}),
IF(ISBLANK({!$Record.UTM_Campaign__c}),&quot;&quot;,{!$Record.UTM_Campaign__c}) &lt;&gt; IF(ISBLANK({!$Record.Contact.UTM_Campaign__c}),&quot;&quot;,{!$Record.Contact.UTM_Campaign__c}),
IF(ISBLANK({!$Record.UTM_Content__c}),&quot;&quot;,{!$Record.UTM_Content__c}) &lt;&gt; IF(ISBLANK({!$Record.Contact.UTM_Content__c}),&quot;&quot;,{!$Record.Contact.UTM_Content__c}),
IF(ISBLANK({!$Record.UTM_Creative_Format__c}),&quot;&quot;,{!$Record.UTM_Creative_Format__c}) &lt;&gt; IF(ISBLANK({!$Record.Contact.UTM_Creative_Format__c}),&quot;&quot;,{!$Record.Contact.UTM_Creative_Format__c}),
IF(ISBLANK({!$Record.UTM_Marketing_Tactic__c}),&quot;&quot;,{!$Record.UTM_Marketing_Tactic__c}) &lt;&gt; IF(ISBLANK({!$Record.Contact.UTM_Marketing_Tactic__c}),&quot;&quot;,{!$Record.Contact.UTM_Marketing_Tactic__c}),
IF(ISBLANK({!$Record.UTM_Medium__c}),&quot;&quot;,{!$Record.UTM_Medium__c}) &lt;&gt; IF(ISBLANK({!$Record.Contact.UTM_Medium__c}),&quot;&quot;,{!$Record.Contact.UTM_Medium__c}),
IF(ISBLANK({!$Record.UTM_Source__c}),&quot;&quot;,{!$Record.UTM_Source__c}) &lt;&gt; IF(ISBLANK({!$Record.Contact.UTM_Source__c}),&quot;&quot;,{!$Record.Contact.UTM_Source__c}),
IF(ISBLANK({!$Record.UTM_Source_Platform__c}),&quot;&quot;,{!$Record.UTM_Source_Platform__c}) &lt;&gt; IF(ISBLANK({!$Record.Contact.UTM_Source_Platform__c}),&quot;&quot;,{!$Record.Contact.UTM_Source_Platform__c}),
IF(ISBLANK({!$Record.UTM_Term__c}),&quot;&quot;,{!$Record.UTM_Term__c}) &lt;&gt; IF(ISBLANK({!$Record.Contact.UTM_Term__c}),&quot;&quot;,{!$Record.Contact.UTM_Term__c})
   )
)
)
),
TRUE, FALSE)</expression>
    </formulas>
