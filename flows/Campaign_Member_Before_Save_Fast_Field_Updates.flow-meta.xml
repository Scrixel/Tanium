    <decisions>
        <name>Created_by_Lead_or_Contact</name>
        <label>Created by Lead or Contact?</label>
        <locationX>281</locationX>
        <locationY>1053</locationY>
        <defaultConnector>
            <targetReference>MQL_Tier_on_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Created by Contact</defaultConnectorLabel>
        <rules>
            <name>Created_by_Lead</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FCRM__FCR_Member_Type_On_Create__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lead</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FCRM__FCR_Member_Type_On_Create__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Lead_MQL_Tier_Blank</targetReference>
            </connector>
            <label>Created by Lead</label>
        </rules>
    </decisions>
