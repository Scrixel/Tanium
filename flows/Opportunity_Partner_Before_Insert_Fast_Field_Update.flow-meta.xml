    <description>Performs updates on the Opportunity Partner object before saving to the database

5/2/24 - Converted from After Insert to Before Insert to align with the name and created a new After Insert flow</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_IncumbentPartner</name>
        <dataType>Boolean</dataType>
        <expression>IF(TEXT({!$Record.Incumbent_Partner_Override__c}) = &apos;TRUE&apos;, TRUE,
IF(TEXT({!$Record.Incumbent_Partner_Override__c}) = &apos;FALSE&apos;, FALSE,
IF({!$Record.Account__c} = {!$Record.Opportunity__r.SBQQ__RenewedContract__r.SBQQ__Quote__r.Downstream_Reseller__c}, TRUE,
IF({!$Record.Account__c} = {!$Record.Opportunity__r.SBQQ__RenewedContract__r.SBQQ__Quote__r.SBQQ__Partner__c}, TRUE,
FALSE))))</expression>
    </formulas>
    <formulas>
        <name>formula_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>formula_UniqueId</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account__c} &amp; {!$Record.Opportunity__c}</expression>
    </formulas>
