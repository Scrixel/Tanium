    <decisions>
        <name>DD_Approver_Record_Returned</name>
        <label>DD Approver Record Returned?</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Screen_No_Approver_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_MatchingDDApproverReturned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Deal_Desk_Approvers_Assignment_Management</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_All_Quote_Values</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Deal_Desk_Values_Need_Assignment</name>
        <label>Deal Desk Values Need Assignment?</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Assign_Opportunity_Quote_Values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>One_or_More_Values_Blank</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.ELV_Deal_Desk_Approver__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote.ELV_Deal_Desk_Approver_Lead_LKUP__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Deal_Desk_Approvers_Assignment_Management</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Screen flow launched from the Submit For Approval Quote action. It fills only blank ELV approver fields from the related Opportunity and Assignment Management; existing Quote values are retained. A screen is shown only on error or when a required Deal Desk mapping is missing.</description>
    <formulas>
        <name>formula_AreaVP</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Quote.ELV_AreaVP__c}), {!Get_Opportunity.AreaVP__c}, {!Get_Quote.ELV_AreaVP__c})</expression>
    </formulas>
    <formulas>
        <name>formula_ChannelProgramManager</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Quote.ELV_Channel_Program_Manager__c}), {!Get_Opportunity.Contract_Partner_Owner__c}, {!Get_Quote.ELV_Channel_Program_Manager__c})</expression>
    </formulas>
    <formulas>
        <name>formula_DealDeskApprover</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Quote.ELV_Deal_Desk_Approver__c}), {!Get_Deal_Desk_Approvers_Assignment_Management.Deal_Desk_Approver__c}, {!Get_Quote.ELV_Deal_Desk_Approver__c})</expression>
    </formulas>
    <formulas>
        <name>formula_DealDeskApproverLead</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Quote.ELV_Deal_Desk_Approver_Lead_LKUP__c}), {!Get_Deal_Desk_Approvers_Assignment_Management.Deal_Desk_Approver_Lead__c}, {!Get_Quote.ELV_Deal_Desk_Approver_Lead_LKUP__c})</expression>
    </formulas>
    <formulas>
        <name>formula_OpportunityContractManager</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Quote.ELV_Opportunity_Contract_Manager__c}), {!Get_Opportunity.Contract_Owner__c}, {!Get_Quote.ELV_Opportunity_Contract_Manager__c})</expression>
    </formulas>
    <formulas>
        <name>formula_OpportunityOwnerRVP</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Quote.ELV_Opp_OwnerManager__c}), {!Get_Opportunity.Opportunity_Manager__c}, {!Get_Quote.ELV_Opp_OwnerManager__c})</expression>
    </formulas>
    <formulas>
        <name>formula_SVP</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Quote.ELV_SVP__c}), {!Get_Opportunity.VP__c}, {!Get_Quote.ELV_SVP__c})</expression>
    </formulas>
    <interviewLabel>Approvals Pro - Assign Quote Values {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Approvals Pro - Assign Quote Values</label>
    <processType>Flow</processType>
    <recordLookups>
        <description>Matches the Deal Desk Approver Assignment Management record on the Quote&apos;s Geo, Region and Sub Region.</description>
        <name>Get_Deal_Desk_Approvers_Assignment_Management</name>
        <label>Get Deal Desk Approvers (Assignment Management)</label>
        <locationX>176</locationX>
        <locationY>420</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>DD_Approver_Record_Returned</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Label.Assignment_Management_Deal_Desk_Approver_Record_Type</elementReference>
            </value>
        </filters>
        <filters>
            <field>Geo__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.ELV_Geo__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Region__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.ELV_Region__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Sub_Region__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.ELV_Sub_Region__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Assignment_Management__c</object>
        <sortField>Geo__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
