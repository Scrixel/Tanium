    <screens>
        <name>Screen_Error</name>
        <label>Error Assigning Quote Values</label>
        <locationX>446</locationX>
        <locationY>840</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Text_Error</name>
            <fieldText>&lt;p&gt;The quote approver values could not be assigned.&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;Please retry. If the error persists, contact your Salesforce administrator with the message above.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_No_Approver_Found</name>
        <label>No Deal Desk Approver Found</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Text_No_Approver_Found</name>
            <fieldText>&lt;p&gt;No Deal Desk Approver could be determined for this quote.&lt;/p&gt;&lt;p&gt;No matching Assignment Management record was found for Geo &lt;b&gt;{!Get_Quote.ELV_Geo__c}&lt;/b&gt;, Region &lt;b&gt;{!Get_Quote.ELV_Region__c}&lt;/b&gt;, Sub Region &lt;b&gt;{!Get_Quote.ELV_Sub_Region__c}&lt;/b&gt;. Existing Quote values were left unchanged. Please confirm the Geo, Region and Sub Region on the Quote, or contact Deal Desk to have the Assignment Management record created.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
