    <description>12/22/25 : SS-12043 - Assign Entitlements
07.23.25 AP: SS-11273 - Update flow to use  new Severity field
SS-10292 - Added Default Case Owner as record owner</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_CaseSeverity</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Severity_Community__c})</expression>
    </formulas>
    <formulas>
        <name>formula_Entitlement_AccountId</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.AccountId} = {!$Label.McDonald_s_Account_Id}, {!$Label.McDonald_s_Account_Id}, {!constant_DefaultEntitlementAccountId})</expression>
    </formulas>
    <formulas>
        <name>formula_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>formula_Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>formula_SeverityCommunity</name>
        <dataType>Number</dataType>
        <expression>VALUE(TEXT($Record.Severity_Community__c))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formula_Tags</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS($Record.Tags__c, &quot;NoOpenCloseEmail&quot;)</expression>
    </formulas>
