    <decisions>
        <description>SS-12975: decision to check whether the Compliance framework is protected _b or not</description>
        <name>Is_Compliance_Framework_protected_b</name>
        <label>Is Compliance Framework = protected_b ?</label>
        <locationX>720</locationX>
        <locationY>897</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_protected_b</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Compliance_Framework__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>protected_b</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Cloud_Provider__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>AWS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Cloud_Provider_AWS</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsNew</name>
        <label>IsNew?</label>
        <locationX>722</locationX>
        <locationY>358</locationY>
        <defaultConnector>
            <targetReference>TaaS_Tanium_as_a_Service</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_IsNew</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Values</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>TaaS_Tanium_as_a_Service</name>
        <label>TaaS/Tanium as a Service?</label>
        <locationX>723</locationX>
        <locationY>524</locationY>
        <defaultConnector>
            <targetReference>Tanium_Cloud_Business_Admin_IsBlank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Tanium_Cloud_TAAS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Server_Device_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Tanium as a Service</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TaaS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Tanium_Infrastructure_TAM_Reporting_Values</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if Tanium Cloud Business Admin is Blank and Tanium Cloud Admin is populated</description>
        <name>Tanium_Cloud_Business_Admin_IsBlank</name>
        <label>Tanium Cloud Business Admin IsBlank?</label>
        <locationX>723</locationX>
        <locationY>715</locationY>
        <defaultConnector>
            <targetReference>Is_Compliance_Framework_protected_b</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Tanium_Cloud_Business_Admin__r.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tanium_Cloud_Admin__r.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tanium_Cloud_Admin__r.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tanium_Cloud_Admin__r.AccountId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Account__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Tanium_Cloud_Business_Admin</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>05/18/26 : SS-12975 - New flow created to comply with Tanium Flow naming convention. Added Decision element to check if Compliance Framework is &apos;protected_b&apos;, If yes, set the value of Cloud Provider to &apos;AWS&apos;
05/07/25 : SS-10499 - Added a Decision element to check if &apos;Tanium Cloud Business Admin&apos; is blank and &apos;Tanium Cloud Admin&apos; is populated. If so, &apos;Tanium Cloud Business Admin&apos; will be assigned the value from &apos;Tanium Cloud Admin</description>
    <environments>Default</environments>
