<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Default_Subject</name>
        <label>Assign Default Subject</label>
        <locationX>889</locationX>
        <locationY>506</locationY>
        <assignmentItems>
            <assignToReference>$Record.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Sub_Type__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Current_Task_a_BMP_Task</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>Constant_PartnerRecordTypeID</name>
        <dataType>String</dataType>
        <value>
            <stringValue>012RO00000A6YawYAF</stringValue>
        </value>
    </constants>
    <customErrors>
        <description>Throw an error if Account is Partner, Task Sub-Type = Business &amp; Marketing Plan” and if the most recent task is not Status=Completed.</description>
        <name>Error_Message</name>
        <label>Error Message</label>
        <locationX>754</locationX>
        <locationY>1159</locationY>
        <customErrorMessages>
            <errorMessage>A new “Business &amp; Marketing Plan” task cannot be created because the most recent one is not marked as Completed.
Copy/paste the link below into your browser to see the existing task : 
{!Formula_GetPreviousTaskLink}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Is_Current_Task_a_BMP_Task</name>
        <label>Is Current Task a BMP Task?</label>
        <locationX>735</locationX>
        <locationY>719</locationY>
        <defaultConnectorLabel>NoNotBMPTask</defaultConnectorLabel>
        <rules>
            <name>YesBMPTask</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Sub_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Business &amp; Marketing Plan</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Task_Record</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Previous_BMP_Task_NOT_Completed</name>
        <label>Task Found?</label>
        <locationX>738</locationX>
        <locationY>976</locationY>
        <defaultConnectorLabel>No Duplicate</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Task_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message</targetReference>
            </connector>
            <label>Duplicate</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Task_Partner</name>
        <label>Is Task = Partner?</label>
        <locationX>728</locationX>
        <locationY>510</locationY>
        <defaultConnector>
            <targetReference>Is_Current_Task_a_BMP_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partner</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sub_Type__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Default_Subject</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsNew</name>
        <label>IsNew?</label>
        <locationX>727</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesNew</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Formula_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Task_Partner</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>SS-11903 - Added default subject for Partner Task
SS-10918 - Can&apos;t create a Partner Task with Sub Type= “Business &amp; Marketing Plan”, if the most recent task is not Status=Completed.</description>
    <environments>Default</environments>
    <formulas>
        <name>Formula_GetPreviousTaskLink</name>
        <dataType>String</dataType>
        <expression>&quot;https://tanium.lightning.force.com/lightning/r/Task/&quot; &amp; {!Get_Task_Record.Id} &amp; &quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>Formula_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Task - Before Insert - Fast Field Updates   - V5 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Task - Before Insert - Fast Field Updates</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get Latest Business &amp; Marketing Plan Task</description>
        <name>Get_Task_Record</name>
        <label>Get Task Record</label>
        <locationX>744</locationX>
        <locationY>851</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Previous_BMP_Task_NOT_Completed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Sub_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Business &amp; Marketing Plan</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>609</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>IsNew</targetReference>
        </connector>
        <filterFormula>NOT({!$Permission.DisableFlows})</filterFormula>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
