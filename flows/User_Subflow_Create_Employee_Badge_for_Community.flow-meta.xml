<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>AT SS-8305: Automate giving employees the Employee Badge. Sub flow triggered from User - After Insert - On Create and Update Flow to create the Tanium Employee Badge to be viewed in Tanium Customer Community.</description>
    <environments>Default</environments>
    <interviewLabel>User - Subflow - {!$Flow.CurrentDateTime}</interviewLabel>
    <label>User - Subflow - Create Employee Badge for Community</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>createWorkBadge</name>
        <label>createWorkBadge</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <inputAssignments>
            <field>DefinitionId</field>
            <value>
                <elementReference>getWorkBadgeDefinitionId.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NetworkId</field>
            <value>
                <elementReference>GetCommunityNetworkId.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecipientId</field>
            <value>
                <elementReference>recUser.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceId</field>
            <value>
                <elementReference>varWorkThanksId</elementReference>
            </value>
        </inputAssignments>
        <object>WorkBadge</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>createWorkThanks</name>
        <label>createWorkThanks</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignRecordIdToReference>varWorkThanksId</assignRecordIdToReference>
        <connector>
            <targetReference>createWorkBadge</targetReference>
        </connector>
        <inputAssignments>
            <field>GiverId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Message</field>
            <value>
                <stringValue>Welcome to the team!</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NetworkId</field>
            <value>
                <elementReference>GetCommunityNetworkId.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>WorkThanks</object>
    </recordCreates>
    <recordLookups>
        <name>GetCommunityNetworkId</name>
        <label>GetCommunityNetworkId</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>getWorkBadgeDefinitionId</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Tanium Customer Community</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Network</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>getWorkBadgeDefinitionId</name>
        <label>getWorkBadgeDefinitionId</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>createWorkThanks</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Tanium Team Member</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkBadgeDefinition</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetCommunityNetworkId</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>RecipientId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recUser</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>
    <variables>
        <description>Used to Story Work Thanks Record created in Flow for reference to Badge Creation Association.</description>
        <name>recWorkThanks</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>WorkThanks</objectType>
    </variables>
    <variables>
        <name>varWorkThanksId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
