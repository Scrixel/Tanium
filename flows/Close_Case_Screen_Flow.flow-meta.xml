    <description>1/16/26: Updated the flow to better improve the design
12/17/25: Make the Incident Cause and Resolution Code as required. 
12/12/25: Added a Fault screen to catch fault(s) from the Get Case and/or CloseCase elements
AM 2/20 : SS-8178 - This Screenflow is used to update Case when closing the record.</description>
    <environments>Default</environments>
    <formulas>
        <description>Extracting the Solution value from the Summary field.</description>
        <name>formula_Resolution</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Resolution_what_actually_worked}), {!Get_Case.Resolution__c}, {!Resolution_what_actually_worked})</expression>
    </formulas>
    <formulas>
        <name>formula_SendEmailDefaultValue</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Mark_as_SPAM}, FALSE, TRUE)</expression>
    </formulas>
    <formulas>
        <name>formula_StatusNotSolved</name>
        <dataType>Boolean</dataType>
        <expression>AND(
   TEXT({!Get_Case.Status}) != &apos;Solved&apos;,
   TEXT({!Get_Case.Status}) != &apos;Closed&apos;,
   TEXT({!Get_Case.Status}) != &apos;Closed as Duplicate&apos;
)</expression>
    </formulas>
    <formulas>
        <description>Extracting the Symptoms value from the Summary field.</description>
        <name>formula_Symptoms</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Symptoms_what_presented_itself}), {!Get_Case.Symptoms__c}, {!Symptoms_what_presented_itself})</expression>
    </formulas>
