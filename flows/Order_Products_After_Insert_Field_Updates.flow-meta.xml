    <description>Will perform actions on a Order Product record after it&apos;s been inserted/saved
2/27/23: Adding Email alert for when Tax Code NS is blank.
4/4/23: Adding last two lines in formula to update NS Tax Code field</description>
    <environments>Default</environments>
    <formulas>
        <name>TaxCodeNSFormula</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Order.ShippingCountry} = &quot;Canada&quot;, &quot;AVATAX-CAN&quot;,
IF({!$Record.Order.Subsidiary_NS__c} = &quot;1&quot;, &quot;AVATAX&quot;,
IF({!$Record.Order.Subsidiary_NS__c} = &quot;15&quot;, &quot;AVATAX&quot;,
IF({!$Record.Order.BillingCountry} = &quot;UK&quot;, &quot;VAT:S-GB&quot;,
IF({!$Record.Order.BillingCountry} = &quot;United Kingdom&quot;, &quot;UNDEF&quot;,
IF({!$Record.Order.Subsidiary_NS__c} = &quot;7&quot;, &quot;VAT:UNDEF-MT&quot;,
IF({!$Record.Order.Subsidiary_NS__c} = &quot;18&quot;, &quot;VAT:UNDEF-NL&quot;,
&quot;VAT:O-GB&quot;)))))))</expression>
    </formulas>
