<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flow that runs before the Opportunity Contact Role record is deleted from the database. This can be used to update related records, when the deletion of the OCR is needed.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_ContactStage</name>
        <dataType>String</dataType>
        <expression>IF(
    OR(
        ISBLANK({!$Record.Opportunity.Account.Number_of_Open_Opportunities__c}),
        {!$Record.Opportunity.Account.Number_of_Open_Opportunities__c} = 0
    ),
    &quot;Unqualified&quot;,
    &quot;Existing Opp&quot;
)</expression>
    </formulas>
    <interviewLabel>Opportunity Contact Role - Before Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Contact Role - Before Delete</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Contact_Stage</name>
        <label>Update Contact Stage</label>
        <locationX>1471</locationX>
        <locationY>380</locationY>
        <inputAssignments>
            <field>Contact_Stage__c</field>
            <value>
                <elementReference>formula_ContactStage</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Contact</inputReference>
    </recordUpdates>
    <start>
        <locationX>1345</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Update_Contact_Stage</targetReference>
        </connector>
        <filterFormula>NOT({!$Permission.DisableFlows})</filterFormula>
        <object>OpportunityContactRole</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
