    <decisions>
        <name>Account_Have_Slack_Channel_Id</name>
        <label>Account Have Slack Channel Id?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Account_Has_Slack_Channel_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Slack_Channel_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Slack_Message_Account_Slack_Channel</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>10.28.25 AT: SS-10602: Send Slack Notifications to Korea Support Center Slack Channel and Customer Slack Channel.</description>
    <environments>Default</environments>
    <formulas>
        <description>Formula used in text Templates to verify if Case&apos;s Account has a Slack Channel Id, and output specific text for Slack notifications.</description>
        <name>formula_AccountSlackChannelIdText</name>
        <dataType>String</dataType>
        <expression>IF(
NOT(ISBLANK({!$Record.Account.Slack_Channel_Id__c})),
&quot;*Customer Channel:*&quot; &amp; BR() &amp;
&quot;&gt;&lt;#&quot; &amp; {!$Record.Account.Slack_Channel_Id__c} &amp; &quot;&gt;&quot;,
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_OrgURL</name>
        <dataType>String</dataType>
        <expression>LEFT($Api.Enterprise_Server_URL_510, FIND( &apos;/services&apos;, $Api.Enterprise_Server_URL_510)) &amp;{!$Record.Id}</expression>
    </formulas>
    <interviewLabel>Case - Slack Notification - Korea Support Model {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - Slack Notification - Korea Support Model</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
