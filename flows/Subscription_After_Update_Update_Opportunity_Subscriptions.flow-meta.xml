    <recordDeletes>
        <description>The subscription is no longer active, so it should not carry ARR on the open renewal opportunity.</description>
        <name>Delete_Opportunity_Subscription</name>
        <label>Delete Opportunity Subscription</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Get_Opportunity_Subscription_to_Remove</inputReference>
    </recordDeletes>
    <recordDeletes>
        <description>Remove the rows stranded on still-open opportunities, so the subscription counts ARR once.</description>
        <name>Delete_Stranded_Opportunity_Subscriptions</name>
        <label>Delete Stranded Opportunity Subscriptions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Renewal_Opportunity</targetReference>
        </connector>
        <inputReference>strandedRows</inputReference>
    </recordDeletes>
    <recordLookups>
        <description>The opportunity subscription joining this subscription to the renewal opportunity it currently points at.</description>
        <name>Get_Opportunity_Subscription</name>
        <label>Get Opportunity Subscription</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Opportunity_Subscription_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Ruby__Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Subscription.Ruby__RenewalOpportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Ruby__Subscription__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Ruby__OpportunitySubscription__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Scoped to the renewal opportunity the subscription points at, so rows on closed opportunities are left alone as historical record.</description>
        <name>Get_Opportunity_Subscription_to_Remove</name>
        <label>Get Opportunity Subscription to Remove</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Found_Opportunity_Subscription_to_Remove</targetReference>
