            </connector>
            <label>Opportunity Subscription Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Found_Opportunity_Subscription_to_Remove</name>
        <label>Found Opportunity Subscription to Remove?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>None - Nothing to Remove</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Subscription_to_Remove</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Opportunity_Subscription</targetReference>
            </connector>
            <label>Found</label>
        </rules>
