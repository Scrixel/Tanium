    </decisions>
    <decisions>
        <name>Check_Opportunity_Subscription_Exists</name>
        <label>Check Opportunity Subscription Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Opportunity_Subscription</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - Create</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Subscription_Exists</name>
            <conditionLogic>and</conditionLogic>
