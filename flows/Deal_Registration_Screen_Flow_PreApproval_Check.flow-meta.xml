    <description>09/24/25: INC0259496 - Updated the Submit for Approval element to include the approval process ID
05/8/25: SS-10623 : Removed Deal Reg Extension Limit
SS-9432: Do not allow approval when Mapped Opp is Closed Won, Failed, or Failed Renewal.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_ApprovalProcessID</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Get_Deal_Reg.or_Opp_Reg_Status__c}) = &apos;Pending&apos;, {!Get_Approval_Process.Id}, {!Get_Extension_Approval_Process.Id})</expression>
    </formulas>
    <formulas>
        <name>formula_DuplicateDealExist</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISBLANK({!Get_Deal_Regs_Approved_or_Pending_Approval.Id}), FALSE, TRUE)</expression>
    </formulas>
    <formulas>
        <description>Describes the item(s) that haven&apos;t been completed in order to allow this Deal to be submitted for approval</description>
        <name>formula_MissingForApproval</name>
        <dataType>String</dataType>
        <expression>IF(OR(ISBLANK({!Get_Deal_Reg.Opp_Reg_Approval_Assignment__c}), {!Get_Deal_Reg.Opp_Reg_Approval_Assignment__c} = 0) , &quot;- Please contact Channel Ops. The Approval Assignment field hasn&apos;t been set correctly. &quot; &amp; BR(), &quot;&quot;) &amp;
IF(ISBLANK({!Get_Deal_Reg.Account__c}) , &quot;- The End Customer Account field is blank. Please populate it.&quot; &amp; BR(), &quot;&quot;) &amp;
IF(TEXT({!Get_Deal_Reg.or_Opp_Reg_Status__c}) = &quot;Pending&quot;, &quot;&quot; , &quot;- The Deal Reg Status field must be Pending or Extension Pending. &quot; &amp; BR()) &amp;
IF(AND(TEXT({!Get_Deal_Reg.or_Opp_Reg_Status__c}) = &quot;Pending&quot;, {!Get_Deal_Reg.Opp_Reg_Extension_Count__c}&lt;&gt;0) , &quot;- The Extension Count field must be 0 for a new Deal Registration approval.&quot; &amp; BR(), &quot;&quot;) &amp;
IF(AND(TEXT({!Get_Deal_Reg.or_Opp_Reg_Status__c}) = &quot;Pending&quot;, {!Get_Deal_Reg.or_New_Opp_Reg__c} = FALSE) , &quot;- The New Deal Reg? field must be selected for a new Deal Registration approval.&quot; &amp; BR() , &quot;&quot;) &amp;
IF(AND(TEXT({!Get_Deal_Reg.or_Opp_Reg_Status__c}) = &quot;Pending&quot;, NOT(ISPICKVAL({!Get_Deal_Reg.or_Opp_Reg_Approval_Flow_Status__c} , &quot;Approvals not started&quot;))) , &quot;- The Deal Reg Approval Flow Status field must be &apos;Approvals not started.&apos; &quot; &amp; BR(), &quot;&quot;) &amp;
IF(AND(TEXT({!Get_Deal_Reg.or_Opp_Reg_Status__c}) = &quot;Pending&quot;, {!Get_Deal_Reg.or_Create_Opportunity_upon_Approval__c}=FALSE , ISBLANK({!Get_Deal_Reg.Mapped_Opportunity__c})) , &quot;- Please enter either a Mapped Opportunity or check the Create Opportunity Upon Approval checkbox.&quot; &amp; BR(), &quot;&quot;) &amp;
IF(OR(TEXT({!Get_Deal_Reg.Mapped_Opportunity__r.StageName}) = &quot;Closed Won&quot;, TEXT({!Get_Deal_Reg.Mapped_Opportunity__r.StageName}) = &quot;Failed&quot;, TEXT({!Get_Deal_Reg.Mapped_Opportunity__r.StageName}) = &quot;Failed Renewal&quot;), &quot;- Map an open oppty to submit for approval.&quot; &amp; BR(), &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_MissingForApprovalExtension</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Deal_Reg.Opp_Reg_Approval_Assignment__c} = 0, &quot;Please contact Channel Ops. Approval Assignment is missing.&quot; &amp; BR(), &quot;&quot;) &amp; 
IF(AND(TEXT({!Get_Deal_Reg.or_Opp_Reg_Status__c}) = &quot;Extension Pending&quot;, {!Get_Deal_Reg.or_New_Opp_Reg__c}), &quot;New Deal must be de-selected for extension Deal Reg approval.&quot; &amp; BR(), &quot;&quot;) &amp; 
IF(AND(TEXT({!Get_Deal_Reg.or_Opp_Reg_Status__c}) = &quot;Extension Pending&quot;, TEXT({!Get_Deal_Reg.or_Opp_Reg_Approval_Flow_Status__c}) != &quot;Approvals not started&quot;),&quot;Approval Flow Status must be &apos;Approvals not started.&apos; &quot; &amp; BR(), &quot;&quot;) &amp;
IF(AND(TEXT({!Get_Deal_Reg.or_Opp_Reg_Status__c}) = &quot;Extension Pending&quot;, {!Get_Deal_Reg.Opp_Reg_Extension_Count__c} &gt;= 3), &quot;Maximum number of extensions have been reached.&quot;, &quot;&quot;)</expression>
    </formulas>
