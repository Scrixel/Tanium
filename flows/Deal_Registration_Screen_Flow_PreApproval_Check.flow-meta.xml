    <decisions>
        <description>If the Lead&apos;s OppReg Status = &apos;Extension Pending&apos; we direct to the extension approval process. Otherwise, we route to the regular OppReg approval process.</description>
        <name>Standard_Or_Extension</name>
        <label>Standard Or Extension?</label>
        <locationX>306</locationX>
        <locationY>379</locationY>
        <defaultConnector>
            <targetReference>Lead_is_not_Ready_Default</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Extension</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Deal_Reg.or_Opp_Reg_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Extension Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Deal_Reg.or_New_Opp_Reg__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Deal_Reg.or_Opp_Reg_Approval_Flow_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approvals not started</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Extension_Approval_Process</targetReference>
            </connector>
            <label>Extension</label>
        </rules>
        <rules>
            <name>Standard</name>
            <conditionLogic>(1 AND 2 AND 3 AND 4 AND (5 OR 6))</conditionLogic>
            <conditions>
                <leftValueReference>Get_Deal_Reg.or_Opp_Reg_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Deal_Reg.Opp_Reg_Extension_Count__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Deal_Reg.or_New_Opp_Reg__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Deal_Reg.or_Opp_Reg_Approval_Flow_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approvals not started</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Deal_Reg.or_Create_Opportunity_upon_Approval__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Deal_Reg.Mapped_Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Approval_Process</targetReference>
            </connector>
            <label>Standard</label>
        </rules>
