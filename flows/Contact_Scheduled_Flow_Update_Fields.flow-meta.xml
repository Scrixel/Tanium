    <decisions>
        <description>Removed Hard Code Id for DSA Sales User and replaced with Custom Label</description>
        <name>SDR_equals_DSA</name>
        <label>SDR equals DSA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_SDR_Values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>SDR_DSA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.BDR__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.DSA_User_Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_DSA_sdr</targetReference>
            </connector>
            <label>SDR = DSA</label>
        </rules>
    </decisions>
    <description>SS-13224: 7/16/26: Move Contact to Stage of &quot;Unqualified&quot; after in Stage of &quot;Working&quot; for 45 days.
SS-13405: 7/16/26: Move Contact to Stage of &quot;Unqualified&quot; after in Stage of &quot;Attempting Contact&quot; for 45 days.
SS-13541: 7/15/26: Addition of Entry criteria for SDR Owner Override
SS-12895: Update logic for SDR Manager to use RVP Override when present
SS-12168: Move Contact to Stage of &quot;Recycle&quot; after in Stage of &quot;Unqualified&quot; for 45 days.
SS-2464 : Ensure Contact SDR and Account SDR values match- Account Based Routing Extension
New Flow to replace Contact - Scheduled Flow - Update SDR</description>
    <environments>Default</environments>
    <formulas>
        <description>SS-12895 If SDR has an RVP Override value, use RVP Override, else ManagerId.</description>
        <name>formula_SDRManager</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Account.BDR__r.RVP_Override__c})),{!$Record.Account.BDR__r.RVP_Override__c},{!$Record.Account.BDR__r.ManagerId})</expression>
    </formulas>
