    <formulas>
        <name>formula_DealRegExpiryDate</name>
        <dataType>Date</dataType>
        <expression>IF(NOT(ISNULL({!$Record.or_Expiry_Date_New_Opp_Reg__c} )) &amp;&amp; NOT(ISNULL({!$Record.or_Expiry_Date_Extension_Opp_Reg__c})),
IF ({!$Record.or_Expiry_Date_Extension_Opp_Reg__c} &lt; {!$Record.or_Expiry_Date_New_Opp_Reg__c}, {!$Record.or_Expiry_Date_New_Opp_Reg__c}, {!$Record.or_Expiry_Date_Extension_Opp_Reg__c}
),
IF(NOT(ISNULL({!$Record.or_Expiry_Date_New_Opp_Reg__c} )),{!$Record.or_Expiry_Date_New_Opp_Reg__c} ,
IF(NOT(ISNULL({!$Record.or_Expiry_Date_Extension_Opp_Reg__c})),{!$Record.or_Expiry_Date_Extension_Opp_Reg__c},null)
)
)</expression>
    </formulas>
    <formulas>
        <name>formula_ExpiryDate</name>
        <dataType>Date</dataType>
        <expression>IF(OR({!$Record.Opp_Reg_Approval_Assignment__c} = 4, {!$Record.Opp_Reg_Approval_Assignment__c} = 5), TODAY() + 180, TODAY() + 120)</expression>
    </formulas>
    <formulas>
        <name>formula_ExtensionExpiryDate</name>
        <dataType>Date</dataType>
        <expression>IF({!formula_DealRegExpiryDate} &gt; TODAY(), {!formula_DealRegExpiryDate}, TODAY()) + 90</expression>
    </formulas>
    <formulas>
        <name>formula_ExtensionUpdateCount</name>
        <dataType>Number</dataType>
        <expression>IF(PRIORVALUE({!$Record.or_Opp_Reg_Status__c}) = &apos;Extension Pending&apos;, {!$Record.Opp_Reg_Extension_Count__c} + 1, {!$Record.Opp_Reg_Extension_Count__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formula_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>formula_OpportunityType</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.or_Create_Opportunity_upon_Approval__c}, 
TEXT({!$Record.or_Opportunity_Type__c}), 
TEXT({!$Record.Mapped_Opportunity__r.Type}))</expression>
    </formulas>
    <formulas>
        <name>formula_StageNumber</name>
        <dataType>Number</dataType>
        <expression>CASE(TEXT({!$Record.Mapped_Opportunity__r.StageName}),
&apos;Prospecting&apos;, 1,
&apos;Discovery&apos;, 2,
&apos;Validating Benefits &amp; Value&apos;, 3,
&apos;Pilot &amp; Value Validated&apos;, 4,
&apos;Tech Win &amp; Negotiations&apos;, 5,
&apos;Waiting for Signature&apos;, 6,
&apos;Uncommitted Renewal&apos;, 7,
&apos;Signed - Paperwork received&apos;, 8,
&apos;CLOSED WON&apos;, 9,
&apos;Failed&apos;, 10,
&apos;POC&apos;, 114,
&apos;Failed Renewal&apos;, 110,
NULL
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>04/28/2026: SS-12730 DR Status Cancelled or Expired should not change regardless of the opportunity stage.</description>
        <name>formula_Status</name>
        <dataType>String</dataType>
        <expression>IF(
  OR(
    ISPICKVAL({!$Record.or_Opp_Reg_Status__c}, &quot;Expired&quot;),
    ISPICKVAL({!$Record.or_Opp_Reg_Status__c}, &quot;Cancelled&quot;)
  ),
  TEXT({!$Record.or_Opp_Reg_Status__c}),

  IF(
    {!formula_StageNumber} = 9,
    &quot;Closed Won&quot;,
    IF(
      {!formula_StageNumber} &gt; 9,
      &quot;Closed Lost&quot;,
      TEXT({!$Record.or_Opp_Reg_Status__c})
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>formula_Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
