<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Sync_Account_From_Dnb</name>
        <label>Sync Account From D&amp;B</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>DNB_AccountSyncOnDemandInvoc</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Sync_Started_Screen</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>accountIds</name>
            <value>
                <elementReference>recordId</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>DNB_AccountSyncOnDemandInvoc</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Account_Id_To_Collection</name>
        <label>Add Account Id To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AccountIdCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Sync_Account_From_Dnb</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Sync_To_Account_Flag</name>
        <label>Check Sync to Account Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Not_Flagged_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Flagged</defaultConnectorLabel>
        <rules>
            <name>Flagged_For_Sync</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_Flagged_For_Sync</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Start_Sync_Screen</targetReference>
            </connector>
            <label>Flagged For Sync</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_there_a_related_D_B_record</name>
        <label>Is there a related D&amp;B record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Related_DnB_Record_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_D_B_Record_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.DNBConnect__D_B_Connect_Company_Profile__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Sync_To_Account_Flag</targetReference>
            </connector>
            <label>Yes - D&amp;B Record Exists</label>
        </rules>
    </decisions>
    <description>Screen Flow on the Account Lightning Page to manually sync D&amp;B data to the Account (SS-13353). The normal sync process occurs via a daily batch job (SS-13236). This Screen Flow expedited the updates made in the batch job and will primarily be used when the &apos;On Demand Update&apos; feature is used in the DNB_RematchUpdateCmp (also on the Account Lightning Page).</description>
    <environments>Default</environments>
    <formulas>
        <description>If the Last Sync Date on the Account is blank, this formula returns text to let the user know the Account has never been synced with its related D&amp;B record. If the Account does have a Last Sync Date, that date is displayed.</description>
        <name>forT_LastSyncDate</name>
        <dataType>String</dataType>
        <expression>IF(
ISNULL({!Get_Account.D_B_Last_Synced_Date__c}), &quot;The Account has never been synced with its related D&amp;B Connect Company Profile record.&quot;, 
&quot;The Account was last synced with its related D&amp;B Connect Company Profile record on &quot; &amp; TEXT(DATEVALUE({!Get_Account.D_B_Last_Synced_Date__c})) &amp; &quot;.&quot;)</expression>
    </formulas>
    <formulas>
        <name>Is_Flagged_For_Sync</name>
        <dataType>Boolean</dataType>
        <expression>{!Get_Account.DNBConnect__D_B_Connect_Company_Profile__r.Sync_to_Account__c}</expression>
    </formulas>
    <interviewLabel>DNB On-Demand Account Sync {!$Flow.CurrentDateTime}</interviewLabel>
    <label>D&amp;B On-Demand Account Sync</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_there_a_related_D_B_record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>No_Related_DnB_Record_Screen</name>
        <label>No Related DnB Record Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Is_there_a_related_D_B_record</targetReference>
        </connector>
        <fields>
            <name>No_Related_DnB_Record</name>
            <fieldText>&lt;p&gt;This Account does not have a related D&amp;amp;B Company Profile record. Use the &lt;strong&gt;&lt;em&gt;Rematch Record &lt;/em&gt;&lt;/strong&gt;button above to match a D&amp;amp;B record to this Account.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Once matched, refresh this page to sync the D&amp;amp;B data to this Account.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Refresh</nextOrFinishButtonLabel>
        <showFooter>false</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Not_Flagged_Screen</name>
        <label>Not Flagged For Sync</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Not_Flagged_Text</name>
            <fieldText>&lt;p&gt;This Account is synced with the most up-to-date D&amp;amp;B data. Refresh the page to check for newly available D&amp;amp;B data. Last synced &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!Get_Account.D_B_Last_Synced_Date__c}&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Start_Sync_Screen</name>
        <label>Sync D&amp;B Data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Add_Account_Id_To_Collection</targetReference>
        </connector>
        <fields>
            <name>Flagged_Text</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;This Account is currently out of sync with the most up-to-date D&amp;amp;B data. Please click the &lt;/span&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;em&gt;Sync D&amp;amp;B Data On Demand&lt;/em&gt;&lt;/strong&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt; button below to start the Account Sync process. {!forT_LastSyncDate}&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Sync D&amp;B Data On Demand</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Sync_Started_Screen</name>
        <label>Sync Started</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Sync_Started_Text</name>
            <fieldText>&lt;p&gt;The Account is being enriched, please refresh the page to confirm the Last Sync Date has been updated to Today&apos;s date. &lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
