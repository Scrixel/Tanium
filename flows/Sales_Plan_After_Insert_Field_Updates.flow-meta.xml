    <decisions>
        <description>Checks the Create Default Sales Plan KPIs custom label to see if new KPI records should be created. If true, create them.</description>
        <name>Create_New_KPIs</name>
        <label>Create New KPIs?</label>
        <locationX>421</locationX>
        <locationY>425</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Create_New_KPIs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Label.Create_Default_Sales_Plan_KPIs</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Default_KPIs</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>New_Record</name>
        <label>New Record?</label>
        <locationX>288</locationX>
        <locationY>425</locationY>
        <defaultConnector>
            <targetReference>Plan_Type_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_New_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Count_of_KPIs__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_New_KPIs</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>If the plan type changes, the commission team wants any existing KPIs deleted and new ones to be created based on the default KPI records</description>
        <name>Plan_Type_Changed</name>
        <label>Plan Type Changed?</label>
        <locationX>139</locationX>
        <locationY>424</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Plan_Type_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Plan_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Plan_Type__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_KPIs</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Records_to_create</name>
        <label>Records to create?</label>
        <locationX>695</locationX>
        <locationY>423</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Records_to_Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Default_KPIs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_thru_Records</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Records_to_Delete</name>
        <label>Records to Delete?</label>
        <locationX>283</locationX>
        <locationY>580</locationY>
        <defaultConnector>
            <targetReference>Create_New_KPIs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Records_to_Delete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_KPIs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_KPIs</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Sets a boolean to allow us to do new record operations</description>
        <name>formula_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
