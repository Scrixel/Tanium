<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>When a change order for a active subscription is activated, the Renewal Quote on the changed Subscriptions is removed. This allows this Subscription to be eligible to be picked up in the nightly Auto Renew Batch and have an updated Renewal Quote generated. When this happens, also need to remove the Renewal Quote lookup on related Subscriptions on the same Renewal Opp so that they all get picked up on the new Renewal Quote.

The Renewal Quote lookup is removed in a different transaction as Subscription Change therefore cannot have Subscription change be an entry condition.</description>
        <name>Renewal_Quote_Removed</name>
        <label>Renewal Quote Removed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Renewal_Quote_Removed_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Ruby__RenewalQuote__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Ruby__RenewalQuote__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Renewal_Quote_on_Related_Subscriptions</targetReference>
            </connector>
            <label>Renewal Quote Removed</label>
        </rules>
    </decisions>
    <description>- When Subscription Version changes, clear the Renewal Quote on related Subscriptions associated with the same Renewal Opp.</description>
    <environments>Default</environments>
    <formulas>
        <name>OrderProductOpportunity</name>
        <dataType>String</dataType>
        <expression>{!$Record.Ruby__OrderProduct__r.Order.Opportunity.Id}</expression>
    </formulas>
    <interviewLabel>Subscription - After Save - On Create or Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subscription - After Save - On Create or Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Find related active Subscriptions associated to the same Renewal Opportunity. Remove the Renewal Quote lookup so that during the nightly batch, the Subscription will be picked up and a fresh renewal Quote is generated.</description>
        <name>Remove_Renewal_Quote_on_Related_Subscriptions</name>
        <label>Remove Renewal Quote on Related Subscriptions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Ruby__RenewalOpportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Ruby__RenewalOpportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Ruby__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>Ruby__RenewalQuote__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Ruby__RenewalQuote__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <object>Ruby__Subscription__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Renewal_Quote_Removed</targetReference>
        </connector>
        <object>Ruby__Subscription__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>currentItem_Filter_to_Basic_or_Enterprise_Wide</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Ruby__Subscription__c</objectType>
    </variables>
    <variables>
        <name>todaysQuantitySum</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
