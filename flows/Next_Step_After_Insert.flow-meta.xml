    <environments>Default</environments>
    <formulas>
        <name>formula_ConcatenatedNextStepCAM</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!formula_NewNextStepText}) + LEN({!$Record.Opportunity__r.CAM_Next_Steps__c}) &lt; 32768, {!formula_NewNextStepText} &amp; BR() &amp; BR() &amp; {!$Record.Opportunity__r.CAM_Next_Steps__c}, {!formula_NewNextStepText} &amp; BR() &amp; BR() &amp; LEFT({!$Record.Opportunity__r.CAM_Next_Steps__c}, LEN({!$Record.Opportunity__r.CAM_Next_Steps__c}) -  LEN({!formula_NewNextStepText})))</expression>
    </formulas>
    <formulas>
        <name>formula_ConcatenatedNextStepTAM</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!formula_NewNextStepText}) + LEN({!$Record.Opportunity__r.TAM_Next_Steps__c}) &lt; 32768, {!formula_NewNextStepText} &amp; BR() &amp; BR() &amp; {!$Record.Opportunity__r.TAM_Next_Steps__c}, {!formula_NewNextStepText} &amp; BR() &amp; BR() &amp; LEFT({!$Record.Opportunity__r.TAM_Next_Steps__c}, LEN({!$Record.Opportunity__r.TAM_Next_Steps__c}) -  LEN({!formula_NewNextStepText})))</expression>
    </formulas>
    <formulas>
        <name>formula_NewNextStepText</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Flow.CurrentDate}) &amp; &apos; - &apos; &amp; 
IF(AND({!$Record.RecordType.Name} = &apos;TAM Next Step&apos;, NOT(ISBLANK({!$Record.TAM_Owner_user__c}))), {!$Record.TAM_Owner_user__r.Full_Name__c}, IF(AND({!$Record.RecordType.Name} = &apos;CAM Next Step&apos;, NOT(ISBLANK({!$Record.CAM__c}))), {!$Record.CAM__r.Full_Name__c}, {!$Record.CreatedBy.Full_Name__c}))
&amp; BR() &amp; 
IF({!$Record.RecordType.Name} = &apos;TAM Next Step&apos;, {!$Record.TAM_Next_Steps__c}, IF({!$Record.RecordType.Name} = &apos;CAM Next Step&apos;, {!$Record.CAM_Next_Steps__c}, NULL))
&amp; BR() &amp; &apos;_________________________________________&apos;</expression>
    </formulas>
