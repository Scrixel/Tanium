<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Clearing Active is what forces the change back through Activate, where the formula is recompiled and the merge fields are rechecked. Approval Status is left alone: who may edit a Source version is controlled by permissions, so a Source record stays Approved.</description>
        <name>Clear_Active</name>
        <label>Clear Active</label>
        <locationX>578</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>$Record.Active__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>A customized instance no longer carries the language that was approved, so it is reclassified and its approval status is withdrawn. Version Type is only changed on the way in: an instance that is already custom keeps its type and simply loses approval again.</description>
        <name>Mark_Custom_And_Unapproved</name>
        <label>Mark Custom and Unapproved</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>versionTypeTextVar</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Custom Quote Instance</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>approvalStatusVar</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Approved</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>updateQuote</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>An edited custom instance loses approval again without changing type.</description>
        <name>Mark_Unapproved</name>
        <label>Mark Unapproved</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>$Record.Approval_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Approved</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.ELV_Approved_By__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>updateQuote</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>One rule per kind of record. The body comparison is shared: a body edit is what matters in every branch, and the sync&apos;s own writes to Rendered Body must not trigger any of them.</description>
        <name>What_Changed</name>
        <label>What Changed?</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Nothing Relevant</defaultConnectorLabel>
        <rules>
            <name>Quote_Instance_Body_Edited</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Version_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quote Instance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fBodyChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Custom_And_Unapproved</targetReference>
            </connector>
            <label>Quote Instance Body Edited</label>
        </rules>
        <rules>
            <name>Custom_Instance_Body_Edited</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Version_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Custom Quote Instance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fBodyChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Unapproved</targetReference>
            </connector>
            <label>Custom Instance Body Edited</label>
        </rules>
        <rules>
            <name>Source_Content_Changed</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Version_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Source</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Active__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fBodyChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fFormulaChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Active</targetReference>
            </connector>
            <label>Source Content Changed</label>
        </rules>
    </decisions>
    <description>Elevate - Keeps the state of a Quote Term Version honest when its content changes. A Source version that is edited goes inactive, so the change has to be re-validated through the Activate action; its Approval Status is left alone, because edit access to Source records is controlled by permissions. A Quote Instance whose body is edited becomes a Custom Quote Instance and goes unapproved, because the language on the quote is no longer the language that was approved. Runs before save, so no extra DML and the record is never briefly in the wrong state. Replaces Quote Terms - Deactivate On Source Change.</description>
    <environments>Default</environments>
    <formulas>
        <description>Trimmed comparison. ISCHANGED alone fires on the whitespace and markup churn a rich text editor introduces without the author typing anything. Only Term Version Body is compared, so the sync writing Rendered Body on every run never looks like an edit.</description>
        <name>fBodyChanged</name>
        <dataType>Boolean</dataType>
        <expression>TRIM(BLANKVALUE({!$Record.Term_Version_Body__c}, &quot;&quot;)) &lt;&gt; TRIM(BLANKVALUE({!$Record__Prior.Term_Version_Body__c}, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>fFormulaChanged</name>
        <dataType>Boolean</dataType>
        <expression>TRIM(BLANKVALUE({!$Record.Tested_Formula__c}, &quot;&quot;)) &lt;&gt; TRIM(BLANKVALUE({!$Record__Prior.Tested_Formula__c}, &quot;&quot;))</expression>
    </formulas>
    <interviewLabel>Quote Terms - Change Manager {!$Flow.CurrentDateTime}</interviewLabel>
