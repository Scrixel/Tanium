    <description>INFO: Deletes older records to try to help manage space and data usage issues. Deleting of ContentDocument records can be temporarily or permanently stopped by changing the value of the Perform Scheduled Delete - ContentDocument custom label from TRUE to FALSE</description>
    <environments>Default</environments>
    <formulas>
        <description>Content Documents older than 180 days are deleted</description>
        <name>formula_ContentDocumentRetentionPeriod</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 180</expression>
    </formulas>
    <formulas>
        <description>Lead and Contact History records older than seven days will be deleted</description>
        <name>formula_HistoryRetentionPeriod</name>
        <dataType>Date</dataType>
        <expression>NOW() - 7</expression>
    </formulas>
