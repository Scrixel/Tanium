        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_CustomerName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Deployment_Verification_Opportunity__r.End_User_Account__c}), {!$Record.Deployment_Verification_Opportunity__r.Account.Name},{!$Record.Deployment_Verification_Opportunity__r.End_User_Account__r.Name})</expression>
    </formulas>
    <formulas>
        <name>formula_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>formula_OppOwnerEmail</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Deployment_Verification_Opportunity__r.Owner.IsActive}, {!$Record.Deployment_Verification_Opportunity__r.Owner.Email},
NULL)</expression>
    </formulas>
    <formulas>
        <name>formula_OppVP</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Deployment_Verification_Opportunity__r.VP__r.IsActive}, {!$Record.Deployment_Verification_Opportunity__r.VP__r.Email},
NULL)</expression>
    </formulas>
    <formulas>
        <name>formula_PartnerSvpEmail</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Organization.IsSandbox}, &apos;tony.beller@tanium.com.invalid&apos;, &apos;tony.beller@tanium.com&apos;)</expression>
    </formulas>
    <formulas>
        <description>Assigns the PFS Owner Email from the Account or End User Account on the Survey&apos;s opportunity</description>
        <name>formula_PfsOwnerEmail</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!$Record.Deployment_Verification_Opportunity__r.Account.PFS_Owner_Email__c})), ISBLANK({!$Record.Deployment_Verification_Opportunity__r.End_User_Account__c}), {!Get_Organization.IsSandbox}), {!$Record.Deployment_Verification_Opportunity__r.Account.PFS_Owner_Email__c} &amp; &apos;.invalid&apos;, IF(AND(NOT(ISBLANK({!$Record.Deployment_Verification_Opportunity__r.Account.PFS_Owner_Email__c})), ISBLANK({!$Record.Deployment_Verification_Opportunity__r.End_User_Account__c}), NOT({!Get_Organization.IsSandbox})), {!$Record.Deployment_Verification_Opportunity__r.Account.PFS_Owner_Email__c}, IF(AND(NOT(ISBLANK({!$Record.Deployment_Verification_Opportunity__r.End_User_Account__r.PFS_Owner_Email__c})), {!Get_Organization.IsSandbox}),{!$Record.Deployment_Verification_Opportunity__r.End_User_Account__r.PFS_Owner_Email__c} &amp; &apos;.invalid&apos;, {!$Record.Deployment_Verification_Opportunity__r.End_User_Account__r.PFS_Owner_Email__c})))</expression>
    </formulas>
    <formulas>
        <name>formula_SurveyCount</name>
        <dataType>Number</dataType>
        <expression>{!var_SurveyCount} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formula_TotalScore</name>
        <dataType>Number</dataType>
