    <decisions>
        <description>Is the Survey New? Or has the Overall Satisfaction score changed?</description>
        <name>New_or_Changed_CSAT</name>
        <label>New or Changed CSAT?</label>
        <locationX>399</locationX>
        <locationY>554</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_NeworChanged</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>formula_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Case_2_Satisfaction__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Case_2_Satisfaction__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Positive_Experience__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Positive_Experience__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Met_Expectations__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Met_Expectations__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Engineer_Knowledgable__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Engineer_Knowledgable__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Professional_Courteous_Responsive__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Professional_Courteous_Responsive__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Through_Surveys.Trusted_Provider__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Trusted_Provider__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Post_Deployment_CSAT_Surveys</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
