    <description>Performs updates on the Sales Plan KPI object before the record has been inserted to the database

6/28/23: Added Entry Criteria for NOT({!$Permission.DisableFlows})</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_CompanionKPIType</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.KPI_Type__c}) = &quot;OTV&quot;, &quot;Quota&quot;, &quot;OTV&quot;)</expression>
    </formulas>
    <formulas>
        <description>Concatenates three of the Sales Plan KPI fields to create the KPI name</description>
        <name>formula_KPIName</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Fiscal_Year__c}) + &quot; - &quot; + TEXT({!$Record.KPI_Label__c}) + &quot; - &quot; + TEXT({!$Record.KPI_Type__c})</expression>
    </formulas>
    <formulas>
        <description>Concatenation of a number of fields to be used in matching rule</description>
        <name>formula_MatchName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Sales_Plan__c} + TEXT({!$Record.Fiscal_Year__c}) + TEXT({!$Record.KPI_Label__c}) +  TEXT({!$Record.KPI_Type__c})</expression>
    </formulas>
    <formulas>
        <name>formula_RatePreview</name>
        <dataType>Number</dataType>
        <expression>IF(TEXT({!$Record.KPI_Type__c}) = &quot;OTV&quot;, ({!$Record.Amount__c}/{!$Record.Companion_Sales_Plan_KPI__r.Amount__c})*100, 0)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Sales Plan KPI - Before Insert - Fast Field Updates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sales Plan KPI - Before Insert - Fast Field Updates</label>
    <processMetadataValues>
