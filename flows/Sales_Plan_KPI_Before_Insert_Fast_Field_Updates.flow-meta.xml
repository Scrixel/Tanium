        <label>Get Companion KPI</label>
        <locationX>545</locationX>
        <locationY>583</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Companion_KPI_returned</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Sales_Plan__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Sales_Plan__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>KPI_Label__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.KPI_Label__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>KPI_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>formula_CompanionKPIType</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sales_Plan_KPI__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>262</locationX>
