    <description>05/19/26 SS-13066: Added Business Motion = Resale and the logic to differentiate the Business of triggering Opportunity.
For non-MSP Renewal Opportunities, this subflow is launched to create Opportunity Partner Records.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_Partner_Role_Match</name>
        <dataType>Boolean</dataType>
        <expression>IF({!varPartnerRoleFromOrignalOppPartner} = &quot;Supply Chain/Procurement&quot;,TRUE,FALSE)</expression>
    </formulas>
    <formulas>
        <name>formula_PartnerId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Contract.SBQQ__Quote__r.Downstream_Reseller__c})), {!Get_Contract.SBQQ__Quote__r.Downstream_Reseller__c}, IF(NOT(ISBLANK({!Get_Contract.SBQQ__Quote__r.SBQQ__Partner__c})), {!Get_Contract.SBQQ__Quote__r.SBQQ__Partner__c}, NULL))</expression>
    </formulas>
