    <description>SS-13102: Remove dependencies for uninstalled managed package; Populate Responded Date field OnCreate or Status changed and Status is Responded
Refined flow with SS-13102
Migrated from Campaign Member - After Insert - Related Objects and Actions
SS-12572: Additional Decision logic and updates for Contact Stage updates
SS-12163: Adding decision to check if the Status has changed to Meeting Booked, then update Contact/Lead Stage</description>
    <environments>Default</environments>
    <formulas>
        <description>Boolean formula to evaluate whether a Contact on Campaign Member meets Meeting Booked criteria.</description>
        <name>formula_ContactMeetingBooked</name>
        <dataType>Boolean</dataType>
        <expression>AND(
TEXT({!$Record.Status}) = &quot;Meeting Booked&quot;,
NOT(ISBLANK({!$Record.ContactId})),
OR(
ISBLANK({!$Record.Contact.StageNumber__c}),
{!$Record.Contact.StageNumber__c} = 1,
{!$Record.Contact.StageNumber__c} = 2,
{!$Record.Contact.StageNumber__c} = 3,
{!$Record.Contact.StageNumber__c} = 4,
{!$Record.Contact.StageNumber__c} = 9,
{!$Record.Contact.StageNumber__c} = 111
)
)</expression>
    </formulas>
    <formulas>
        <description>Boolean formula to evaluate whether a Contact on Campaign Member meeting Success Response criteria.</description>
        <name>formula_ContactSuccessResponse</name>
        <dataType>Boolean</dataType>
        <expression>AND(
TEXT({!$Record.Status}) = &quot;Success&quot;,
CONTAINS({!$Record.Campaign.Name}, &quot;AI_Global_Qualified_AI-Email&quot;),
NOT(ISBLANK({!$Record.ContactId}))
)</expression>
    </formulas>
    <formulas>
        <description>Boolean formula to evaluate whether a Contact on Campaign Member meets Unsuccessful Response criteria.</description>
        <name>formula_ContactUnsuccessfulResponse</name>
        <dataType>Boolean</dataType>
        <expression>AND(
TEXT({!$Record.Status}) = &quot;Unsuccessful&quot;,
CONTAINS({!$Record.Campaign.Name}, &quot;AI_Global_Qualified_AI-Email&quot;),
NOT(ISBLANK({!$Record.ContactId}))
)</expression>
    </formulas>
    <formulas>
        <name>formula_IsNew</name>
