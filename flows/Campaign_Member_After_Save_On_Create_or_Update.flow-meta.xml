        <expression>isnew()</expression>
    </formulas>
    <formulas>
        <description>Boolean formula to evaluate whether a Lead on Campaign Member meets Meeting Booked criteria.</description>
        <name>formula_LeadMeetingBooked</name>
        <dataType>Boolean</dataType>
        <expression>AND(
TEXT({!$Record.Status}) = &quot;Meeting Booked&quot;,
NOT(ISBLANK({!$Record.LeadId})),
OR(
ISBLANK({!$Record.Lead.StageNumber__c}),
{!$Record.Lead.StageNumber__c} = 1,
{!$Record.Lead.StageNumber__c} = 2,
{!$Record.Lead.StageNumber__c} = 3,
{!$Record.Lead.StageNumber__c} = 4,
{!$Record.Lead.StageNumber__c} = 111
)
)</expression>
    </formulas>
    <formulas>
