    <formulas>
        <description>Formula used to identify the &quot;linear&quot; progression and identify date/time fields to populate for Stage Entry/Exit stamping.</description>
        <name>form_ContactStageProgression</name>
        <dataType>Number</dataType>
        <expression>IF(AND(ISPICKVAL({!$Record__Prior.Contact_Stage__c}, &quot;&apos;&apos;&quot;), ISPICKVAL({!$Record.Contact_Stage__c}, &quot;New&quot;)), 1, 
IF(AND(ISPICKVAL({!$Record__Prior.Contact_Stage__c}, &quot;New&quot;), ISPICKVAL({!$Record.Contact_Stage__c}, &quot;Response&quot;)), 2, IF(AND(ISPICKVAL({!$Record__Prior.Contact_Stage__c}, &quot;Response&quot;), ISPICKVAL({!$Record.Contact_Stage__c}, &quot;Marketing Qualified Lead (MQL)&quot;)), 3, 
IF(AND(ISPICKVAL({!$Record__Prior.Contact_Stage__c}, &quot;Marketing Qualified Lead (MQL)&quot;), ISPICKVAL({!$Record.Contact_Stage__c}, &quot;Attempting Contact&quot;)), 4, 
IF(AND(ISPICKVAL({!$Record__Prior.Contact_Stage__c}, &quot;Attempting&quot;), ISPICKVAL({!$Record.Contact_Stage__c}, &quot;Working&quot;)), 5, 
IF(AND(ISPICKVAL({!$Record__Prior.Contact_Stage__c}, &quot;Working&quot;), ISPICKVAL({!$Record.Contact_Stage__c}, &quot;Sales Accepted Lead (SAL)&quot;)), 6, 
IF(AND(ISPICKVAL({!$Record__Prior.Contact_Stage__c}, &quot;Sales Accepted Lead (SAL)&quot;), ISPICKVAL({!$Record.Contact_Stage__c}, &quot;Sales Qualified Lead (SQL)&quot;)), 7, 
IF(AND(ISPICKVAL({!$Record__Prior.Contact_Stage__c}, &quot;Sales Validated Lead (SVL)&quot;), ISPICKVAL({!$Record.Contact_Stage__c}, &quot;Customer&quot;)), 8,
IF(AND(ISPICKVAL({!$Record__Prior.Contact_Stage__c}, &quot;New&quot;), ISPICKVAL({!$Record.Contact_Stage__c}, &quot;Response&quot;)), 9,  
0)))))))))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formula_Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>formula_StageDateFieldForUpdate</name>
        <dataType>String</dataType>
        <expression>IF({!form_ContactStageProgression} = 2, &quot;Response_Entry_Date__c&quot;,&quot;&quot;)</expression>
    </formulas>
    <formulas>
