    <formulas>
        <name>Recipients_with_Null_Check</name>
        <dataType>String</dataType>
        <expression>/* Customer Success Owner*/
IF
((ISNULL({!$Record.CSM_Account_Owner__r.Email}) || 
{!$Record.CSM_Account_Owner__r.IsActive}=FALSE),&quot;&quot;,
{!$Record.CSM_Account_Owner__r.Email})
+&quot;,&quot;+
/* Economic Buyer*/
IF
((ISNULL({!$Record.Economic_Buyer_Lookup__r.Email}) ||
{!$Record.Economic_Buyer_Lookup__r.HasOptedOutOfEmail}=TRUE),&quot;&quot;,
{!$Record.Economic_Buyer_Lookup__r.Email})
+&quot;,&quot;+
/* Opportunity Owner*/
IF
((ISNULL({!$Record.Owner.Email}) || 
{!$Record.Owner.IsActive}=FALSE),&quot;&quot;,
{!$Record.Owner.Email})
+&quot;,&quot;+
/*Primary Opportunity Contact*/
IF
((ISNULL({!$Record.Primary_Opportunity_Contact__r.Email})||{!$Record.Primary_Opportunity_Contact__r.HasOptedOutOfEmail}=TRUE),&quot;&quot;,
{!$Record.Primary_Opportunity_Contact__r.Email})
+&quot;,&quot;+
/*Procurement Contact*/
IF
((ISNULL({!$Record.Procurement_Contact__r.Email}) || 
{!$Record.Procurement_Contact__r.HasOptedOutOfEmail}=TRUE),&quot;&quot;,
{!$Record.Procurement_Contact__r.Email})</expression>
    </formulas>
    <formulas>
        <name>TestOptOut</name>
        <dataType>String</dataType>
        <expression>IF
((ISNULL({!$Record.Procurement_Contact__r.Email})&amp;&amp;{!$Record.Procurement_Contact__r.HasOptedOutOfEmail}=FALSE)
,&quot;&quot;,
{!$Record.Procurement_Contact__r.Email})

/*
IF
(ISNULL({!$Record.Procurement_Contact__r.Email}),&quot;&quot;,
{!$Record.Procurement_Contact__r.Email})
*/</expression>
    </formulas>
