    <description>Elevate - The only supported path to activate a Quote Term Version. Validates the Tested Formula against the Quote object and every merge field in the Term Version Body. Launched two ways: Activate validates what is stored and activates it, and Edit Formula or Body opens the editor first. When the formula or body of a Source version actually changes, the record is not edited in place - it is kept as a Previous Source Version and the new wording is written to a new active Source version linked back to it, which is how the history of rich text language is retained.</description>
    <environments>Default</environments>
    <formulas>
        <description>True when the stored or entered Term Version Body has no non-whitespace value.</description>
        <name>fBodyBlank</name>
        <dataType>Boolean</dataType>
        <expression>LEN(TRIM(BLANKVALUE({!varBody}, &quot;&quot;))) = 0</expression>
    </formulas>
    <formulas>
        <description>Trimmed comparison, matching the change manager. A rich text editor churns whitespace and markup without the author typing anything, and that must not count as a new version.</description>
        <name>fBodyChanged</name>
        <dataType>Boolean</dataType>
        <expression>TRIM(BLANKVALUE({!varBody}, &quot;&quot;)) &lt;&gt; TRIM(BLANKVALUE({!varTermVersion.Term_Version_Body__c}, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>fContentChanged</name>
        <dataType>Boolean</dataType>
        <expression>{!fBodyChanged} || {!fFormulaChanged}</expression>
    </formulas>
    <formulas>
        <description>True when the stored or entered Tested Formula has no non-whitespace value.</description>
        <name>fFormulaBlank</name>
        <dataType>Boolean</dataType>
        <expression>LEN(TRIM(BLANKVALUE({!varFormula}, &quot;&quot;))) = 0</expression>
    </formulas>
    <formulas>
        <name>fFormulaChanged</name>
        <dataType>Boolean</dataType>
        <expression>TRIM(BLANKVALUE({!varFormula}, &quot;&quot;)) &lt;&gt; TRIM(BLANKVALUE({!varTermVersion.Tested_Formula__c}, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <description>The first version in the chain. A record that has never been superseded is its own root.</description>
        <name>fLineageRoot</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!varTermVersion.Lineage_Root__c}, {!varTermVersion.Id})</expression>
    </formulas>
    <formulas>
        <description>Lists the required field or fields that are blank.</description>
        <name>fMissingFieldsMessage</name>
        <dataType>String</dataType>
        <expression>IF({!fFormulaBlank}, &quot;Tested Formula&quot;, &quot;&quot;) &amp; IF(AND({!fFormulaBlank}, {!fBodyBlank}), &quot; and &quot;, &quot;&quot;) &amp; IF({!fBodyBlank}, &quot;Term Version Body&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>True when activation must stop because a required value is blank.</description>
        <name>fMissingRequiredContent</name>
        <dataType>Boolean</dataType>
        <expression>{!fFormulaBlank} || {!fBodyBlank}</expression>
    </formulas>
