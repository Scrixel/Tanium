    <decisions>
        <description>Check if users and accept or reject were actually selected.</description>
        <name>Check_selections</name>
        <label>Check selections</label>
        <locationX>1036</locationX>
        <locationY>36</locationY>
        <defaultConnector>
            <targetReference>Update_Status_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nothing Selected</defaultConnectorLabel>
        <rules>
            <name>Users_and_Status_selected</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>var_UsersSelected</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>chc_Accept</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>chc_Reject</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>All_Membership_Requests</targetReference>
            </connector>
            <label>Users and Status selected</label>
        </rules>
        <rules>
            <name>Users_No_Status_selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_UsersSelected</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>chc_Accept</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>chc_Reject</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_Error</targetReference>
            </connector>
            <label>Users No Status selected</label>
        </rules>
        <rules>
            <name>No_Users_but_Status</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>var_UsersSelected</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>chc_Accept</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>chc_Reject</leftValueReference>
                <operator>WasSelected</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_Error</targetReference>
            </connector>
            <label>No Users but Status</label>
        </rules>
