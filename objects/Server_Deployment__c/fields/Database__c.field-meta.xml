    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Remote</fullName>
                <default>false</default>
                <label>Remote</label>
            </value>
            <value>
                <fullName>Local</fullName>
                <default>false</default>
                <label>Local</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
