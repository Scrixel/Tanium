<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Server_Version_Require</fullName>
    <active>true</active>
    <description>2020-08-25 Case 53642 require Server Version</description>
    <errorConditionFormula>AND( NOT(ISNUMBER(SUBSTITUTE(Server_Version__c, &quot;.&quot;,&quot;&quot;))),
NOT( RecordType.DeveloperName = &quot;TaaS&quot;),
NOT($Permission.DisableValidationRules))</errorConditionFormula>
    <errorDisplayField>Server_Version__c</errorDisplayField>
    <errorMessage>Server Version must be numeric values only.</errorMessage>
</ValidationRule>
