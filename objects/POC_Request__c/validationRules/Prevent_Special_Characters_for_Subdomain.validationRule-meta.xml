<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Special_Characters_for_Subdomain</fullName>
    <active>true</active>
    <description>Used for subdomain field to prevent use of special characters.</description>
    <errorConditionFormula>NOT(REGEX( Subdomain__c , &quot;^[a-zA-Z0-9-.]*$&quot;))</errorConditionFormula>
    <errorDisplayField>Subdomain__c</errorDisplayField>
    <errorMessage>Alphanumeric only, no special characters.</errorMessage>
</ValidationRule>
