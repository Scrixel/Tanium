<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MonthsFromEstimatedInvoiceDateOrder1__c</fullName>
    <externalId>false</externalId>
    <formula>((YEAR( Billing_Date__c ) - YEAR( EstimatedInvoiceDateOrder1__c ))*12) + (MONTH(Billing_Date__c) - MONTH(EstimatedInvoiceDateOrder1__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>calculate the months between the estimated invoice date (MM-YY) and the Order 1 estimated invoice date (MM-YY) ignoring the day of the month</inlineHelpText>
    <label>MonthsFromEstimatedInvoiceDate - Order1</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
