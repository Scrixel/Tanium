<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Per_of_Quote_Amount__c</fullName>
    <description>Billing amount as Quote amount %</description>
    <formula>IF(Opportunity__r.Amount = 0 ,0,Net_Billing_Amount__c / Opportunity__r.Amount)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Billing amount as Quote amount %</inlineHelpText>
    <label>% of Quote Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
