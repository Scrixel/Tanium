<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ELV_ARR_Margin__c</fullName>
    <formula>IF(
    ELV_ARR_Margin_Override__c &gt; 0,
    ELV_ARR_Margin_Override__c,
    (ELV_Day_1_ARR__c - ELV_Total_COGS__c) / ELV_Day_1_ARR__c
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Sales ARR Margin %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Percent</type>
</CustomField>
