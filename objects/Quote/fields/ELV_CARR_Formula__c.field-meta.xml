<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ELV_CARR_Formula__c</fullName>
    <formula>IF(AND(Opportunity.IsClosed,Not(Opportunity.IsWon)), ELV_Incoming_ARR_formula__c * -1,IF(ELV_Day_1_ARR__c &gt;= ELV_Incoming_ARR_formula__c, 0, ELV_Day_1_ARR__c - ELV_Incoming_ARR_formula__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Sales CARR (Churn ARR)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
