<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ruby__templace_cannot_be_primary</fullName>
    <active>true</active>
    <errorConditionFormula>Ruby__Is_Template_Quote__c = True &amp;&amp; Ruby__IsPrimaryQuote__c  = True</errorConditionFormula>
    <errorDisplayField>Ruby__Is_Template_Quote__c</errorDisplayField>
