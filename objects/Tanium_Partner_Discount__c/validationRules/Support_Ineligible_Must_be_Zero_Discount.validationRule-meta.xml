<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Support_Ineligible_Must_be_Zero_Discount</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
     NOT(Support_Eligible__c),
     Support_Discount__c != 0
)</errorConditionFormula>
    <errorDisplayField>Support_Discount__c</errorDisplayField>
    <errorMessage>Since you&apos;ve indicated that this is a support ineligible record, then the Support Discount (%) field must be zero</errorMessage>
</ValidationRule>
