<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Modules</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL ( Status__c, &quot;Expected Outcome Achieved&quot;), AND (ISBLANK (  Modules_Used_To_Satify_Business_Objectiv__c)))</errorConditionFormula>
    <errorDisplayField>Modules_Used_To_Satify_Business_Objectiv__c</errorDisplayField>
    <errorMessage>If Status equals Expected Outcome Achieved, please complete the Solution Area and Modules Used to Satisfy Business Objective fields.</errorMessage>
</ValidationRule>
