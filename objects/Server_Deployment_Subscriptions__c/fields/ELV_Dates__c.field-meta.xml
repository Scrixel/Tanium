<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ELV_Dates__c</fullName>
    <description>Formula field use to concatenate the Subscription Start Date and Subscription End Date so that we can use the field on the Right Rail Related List (SS-13765)</description>
    <externalId>false</externalId>
    <formula>TEXT(MONTH(ELV_Subscription_Start_Date__c)) &amp; &quot;/&quot; &amp; TEXT(DAY(ELV_Subscription_Start_Date__c)) &amp; &quot;/&quot; &amp; TEXT(YEAR(ELV_Subscription_Start_Date__c)) &amp; &quot; to &quot; &amp; TEXT(MONTH(ELV_Subscription_End_Date__c)) &amp; &quot;/&quot; &amp; TEXT(DAY(ELV_Subscription_End_Date__c)) &amp; &quot;/&quot; &amp; TEXT(YEAR(ELV_Subscription_End_Date__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Dates</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
