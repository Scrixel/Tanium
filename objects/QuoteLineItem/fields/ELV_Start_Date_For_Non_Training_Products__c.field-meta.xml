<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ELV_Start_Date_For_Non_Training_Products__c</fullName>
    <description>TNCI-97 Field created to avoid Training Product&apos;s Start Date printing on Quote Doc.</description>
    <formula>IF(
ISPICKVAL(
ELV_SubscriptionPricing__c , &quot;Fixed Price&quot;), Ruby__SubscriptionStartDate__c,NULL
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Start Date For Non Training Products</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Date</type>
</CustomField>
