<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>L1_L2_Support_Partner__c</fullName>
    <deleteConstraint>SetNull</deleteConstraint>
    <description>Previous Filter Logic: (1 AND 2 AND (3 AND (4 OR 5) AND 6) OR ( NOT (3) AND 4)). 3: Quote: Partner Program Bucket = MSP
Added a filter to ensure that MSP-verified L1/L2 Support Provider could be selected. Also updated Lookup Filter #4 on the L1/L2 Support Provider Quote field to reference the Support Verified checkbox. SS-13460</description>
    <inlineHelpText>If partner, see list linked above in the “Helpful Links” right rail. If Tanium, select “Tanium Support Center”</inlineHelpText>
    <label>L1/L2 Support Provider</label>
    <lookupFilter>
        <active>true</active>
        <booleanFilter>1 AND 2 AND ((3 AND (4 OR 5) AND 6) OR ( NOT 3 AND (4 OR 5)) OR ((7 OR 8) AND 6))</booleanFilter>
        <filterItems>
            <field>$Source.ApprovalStatus__c</field>
            <operation>notEqual</operation>
            <value>Approved</value>
        </filterItems>
        <filterItems>
            <field>$Profile.Name</field>
            <operation>notContain</operation>
            <value>Integration</value>
        </filterItems>
        <filterItems>
            <field>$Source.Partner_Program_Bucket__c</field>
            <operation>equals</operation>
            <value>MSP</value>
        </filterItems>
        <filterItems>
            <field>Account.Support_Verified__c</field>
            <operation>equals</operation>
            <value>True</value>
        </filterItems>
        <filterItems>
            <field>Account.MSP_EM_RS_Accredited__c</field>
            <operation>equals</operation>
            <value>True</value>
        </filterItems>
        <filterItems>
            <field>Account.Name</field>
            <operation>notEqual</operation>
            <value>Tanium Support Center</value>
        </filterItems>
        <filterItems>
            <field>Account.MSP_EM_Verified__c</field>
            <operation>equals</operation>
            <value>True</value>
        </filterItems>
        <filterItems>
            <field>Account.MSP_RS_Verified__c</field>
            <operation>equals</operation>
            <value>True</value>
        </filterItems>
        <isOptional>true</isOptional>
    </lookupFilter>
    <referenceTo>Account</referenceTo>
    <relationshipLabel>Quotes (L1/L2 Support Partner)</relationshipLabel>
    <relationshipName>Support_Partners</relationshipName>
    <required>false</required>
    <trackHistory>true</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Lookup</type>
</CustomField>
