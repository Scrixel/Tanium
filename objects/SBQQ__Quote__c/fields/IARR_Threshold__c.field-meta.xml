<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IARR_Threshold__c</fullName>
    <description>Calculates Incoming ARR Threshold (Incoming ARR x .2) per bookings policy.  SS-10270</description>
    <formula>SBQQ__Opportunity2__r.Incoming_ARR__c * 0.2</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>IARR Threshold</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
