<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cant_Clone_Closed_Quotes</fullName>
    <active>true</active>
    <errorConditionFormula>AND (
    ISCLONE(),
    ISNEW(),
    SBQQ__Opportunity2__r.IsClosed,
    NOT($Permission.DisableValidationRules)
)</errorConditionFormula>
    <errorMessage>You can&apos;t clone a quote on a closed opportunity</errorMessage>
</ValidationRule>
