<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_modification_on_approved_quote</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISCHANGED( SBQQ__Partner__c ),
!IsClone(),
ISPICKVAL(ApprovalStatus__c, &quot;Approved&quot;)
)</errorConditionFormula>
    <errorDisplayField>SBQQ__Partner__c</errorDisplayField>
    <errorMessage>Partner can not be changed on an Approved Quote</errorMessage>
</ValidationRule>
