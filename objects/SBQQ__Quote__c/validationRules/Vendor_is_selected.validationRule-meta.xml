<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Vendor_is_selected</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(SBQQ__Partner__r.Type, &apos;Vendor&apos;),
    NOT(ISPICKVAL(SBQQ__Opportunity2__r.StageName, &apos;CLOSED WON&apos;)),
    NOT(ISCLONE()),
    NOT($Permission.DisableValidationRules)
)</errorConditionFormula>
    <errorDisplayField>SBQQ__Partner__c</errorDisplayField>
    <errorMessage>Vendor is not allowed in Partner field. Please select a Partner.</errorMessage>
</ValidationRule>
