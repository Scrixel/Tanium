<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ruby__Order_Product_Deactivation_Not_Allowed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(PRIORVALUE( Ruby__Status__c ),&apos;Activated&apos;), ISPICKVAL(Ruby__Status__c, &apos;Draft&apos;))</errorConditionFormula>
    <errorMessage>Order product deactivation is not allowed, please cancel the order to deactivate the order product</errorMessage>
</ValidationRule>
