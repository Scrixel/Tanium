<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Stop_Start_Date</fullName>
    <active>true</active>
    <description>Require Stop/Start date when Type = Stop/Start</description>
    <errorConditionFormula>ISPICKVAL(Type__c, &apos;Stop/Start&apos;) &amp;&amp; ISBLANK(Stop_Start_Date__c)</errorConditionFormula>
    <errorDisplayField>Stop_Start_Date__c</errorDisplayField>
    <errorMessage>Stop/Start Date required.</errorMessage>
</ValidationRule>
