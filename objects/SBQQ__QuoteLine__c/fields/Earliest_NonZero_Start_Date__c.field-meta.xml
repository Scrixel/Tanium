<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Earliest_NonZero_Start_Date__c</fullName>
    <description>Exclude Quote Lines from Earliest Start Date Rollup where Quantity is zero.</description>
    <formula>IF( SBQQ__EffectiveQuantity__c &gt;0,SBQQ__EffectiveStartDate__c , Null)</formula>
    <label>Earliest NonZero Start Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Date</type>
</CustomField>
