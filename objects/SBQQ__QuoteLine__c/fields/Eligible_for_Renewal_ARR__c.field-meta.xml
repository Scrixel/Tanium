<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Eligible_for_Renewal_ARR__c</fullName>
    <description>Used in Price Rule to stamp Day 1 ARR Start Date. SS-10607</description>
    <formula>AND( 
   NOT(Exclude_from_ARR__c), 
   SBQQ__EffectiveQuantity__c &lt;&gt; 0,
   NOT(Is_Cloned_Quote_Line__c),
   NOT(ISBLANK(SBQQ__RenewedSubscription__c))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Eligible for Renewal ARR</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
