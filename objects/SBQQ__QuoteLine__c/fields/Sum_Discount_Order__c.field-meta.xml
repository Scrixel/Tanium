<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sum_Discount_Order__c</fullName>
    <description>New sum field for Order creation - post Partner Discount</description>
    <formula>IF(  !ISBLANK(TEXT( Bundle_Type__c )),  End_customer_Discount__c , 

IF(ISPICKVAL(Promotion__c, &quot;&quot;),(1-(1-Customer_Discount__c)*(1- SBQQ__PartnerDiscount__c )),1
))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>New sum field for Order creation - post Partner Discount</inlineHelpText>
    <label>Sum Discount Order</label>
    <precision>18</precision>
    <required>false</required>
    <scale>4</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
