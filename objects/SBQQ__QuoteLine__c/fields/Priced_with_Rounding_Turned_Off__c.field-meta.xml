<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Priced_with_Rounding_Turned_Off__c</fullName>
    <formula>IF(LEN(TEXT(ABS(SBQQ__NetPrice__c - (FLOOR(SBQQ__NetPrice__c))))) &gt; 3, TRUE, FALSE)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>If this field returns True, then rounding was turned off when the price for this line was calculated</inlineHelpText>
    <label>Priced with Rounding Turned Off</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
