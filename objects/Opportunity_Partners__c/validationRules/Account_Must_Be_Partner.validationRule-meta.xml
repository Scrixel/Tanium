<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_Must_Be_Partner</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    Account__r.RecordType.DeveloperName != &apos;Partner&apos;,
    NOT($Permission.DisableValidationRules)
)</errorConditionFormula>
    <errorMessage>Selection is not a Partner account. Please select account where Account Record Type is Partner.</errorMessage>
</ValidationRule>
